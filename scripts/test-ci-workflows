#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
pr_workflow="$repo_root/.github/workflows/pr-check.yml"
release_workflow="$repo_root/.github/workflows/release.yml"
taskfile="$repo_root/Taskfile.yml"

fail() {
	echo "FAIL: $*" >&2
	exit 1
}

[[ -f "$pr_workflow" ]] || fail "pr-check.yml is missing"
[[ -f "$release_workflow" ]] || fail "release.yml is missing"
[[ -f "$taskfile" ]] || fail "Taskfile.yml is missing"

extract_job() {
	local job_id=$1
	awk -v job_id="$job_id" '
		BEGIN { job_key = "  " job_id ":" }
		$0 == job_key { copying = 1 }
		copying && $0 ~ /^  [[:alnum:]_-]+:$/ && $0 != job_key { exit }
		copying { print }
	' "$pr_workflow"
}

job_mentions_task_name() {
	local job_body=$1
	local task_name=$2
	rg -q \
		"(^|[^[:alnum:]_:-])${task_name}([^[:alnum:]_:-]|$)" \
		<<<"$job_body"
}

job_line() {
	local job_body=$1
	local needle=$2
	local job_id
	local line
	job_id=${job_body%%$'\n'*}
	job_id=${job_id#"  "}
	job_id=${job_id%:}
	line=$(awk -v needle="$needle" 'index($0, needle) { print NR; exit }' \
		<<<"$job_body")
	[[ -n "$line" ]] \
		|| fail "$job_id job is missing ordering needle: $needle"
	printf '%s\n' "$line"
}

for job_id in validate-core build-apple build-android; do
	rg -q "^  $job_id:$" "$pr_workflow" \
		|| fail "pull-request workflow must have a $job_id job"
done

core_job=$(extract_job validate-core)
apple_job=$(extract_job build-apple)
android_job=$(extract_job build-android)

project_test_line=$(awk '/^[[:space:]]+- task: test:project$/{ print NR; exit }' "$taskfile")
foundry_script_test_line=$(awk '/^[[:space:]]+- task: test:foundry-script$/{ print NR; exit }' "$taskfile")
[[ -n "$project_test_line" && -n "$foundry_script_test_line" ]] \
	|| fail "Taskfile.yml must run both project and FoundryScript tests"
(( project_test_line < foundry_script_test_line )) \
	|| fail "Taskfile.yml must install project packages before FoundryScript lint"

rg -q 'actions/checkout@v7\.0\.1([[:space:]]|$)' "$release_workflow" \
	|| fail "release.yml must use actions/checkout@v7.0.1"
rg -q 'actions/setup-go@v7\.0\.0([[:space:]]|$)' "$release_workflow" \
	|| fail "release.yml must use actions/setup-go@v7.0.0"
rg -q 'go-task/setup-task@v2\.1\.0([[:space:]]|$)' "$release_workflow" \
	|| fail "release.yml must use go-task/setup-task@v2.1.0"
rg -q 'v0\.1\.0-alpha\.7' "$release_workflow" \
	|| fail "release.yml must pin Foundry v0.1.0-alpha.7"
rg -q 'project import --project' "$release_workflow" \
	|| fail "release.yml must use command-first project import"
rg -Fq 'go install github.com/cafecito-games/foundry-tools/cmd/anvil@176f5f7c5909c07c785fe6e1fd21051e0c13c5bf' \
	"$release_workflow" \
	|| fail "release.yml must pin Anvil to the immutable v0.0.1 commit"
if rg -q 'foundry-tools/cmd/anvil@latest' "$release_workflow"; then
	fail "release.yml must not install Anvil from a mutable latest reference"
fi
rg -q 'task test' "$release_workflow" \
	|| fail "release.yml must run the repository test gate"

for workflow in "$pr_workflow" "$release_workflow"; do
	if rg -n -- '--headless[[:space:]]+--path|--headless[[:space:]]+--editor|--check-only' "$workflow"; then
		fail "$(basename "$workflow") contains a deprecated Foundry invocation"
	fi
	if rg -n -i 'actions/setup-python|pip[[:space:]]+install|requirements\.txt|gdtoolkit' "$workflow"; then
		fail "$(basename "$workflow") must not depend on obsolete Python tooling"
	fi
done

[[ ! -e "$repo_root/requirements.txt" ]] \
	|| fail "requirements.txt must remain absent"

global_release_permission=$(
	awk '/^permissions:$/{ getline; print; exit }' "$release_workflow"
)
[[ "$global_release_permission" == "  contents: read" ]] \
	|| fail "release workflow must default to read-only contents permission"
rg -q -U '^concurrency:\n  group: release-\$\{\{ github\.repository \}\}-\$\{\{ github\.workflow \}\}\n  cancel-in-progress: false$' \
	"$release_workflow" \
	|| fail "release workflow must serialize manual releases per repository and workflow"
rg -q '^  build:$' "$release_workflow" \
	|| fail "release workflow must have a build job"
rg -q '^  publish:$' "$release_workflow" \
	|| fail "release workflow must have a separate publish job"

build_job=$(sed -n '/^  build:$/,/^  publish:$/p' "$release_workflow")
publish_job=$(sed -n '/^  publish:$/,$p' "$release_workflow")
rg -q '^    permissions:$' <<<"$build_job" \
	|| fail "release build job must declare permissions"
rg -q '^      contents: read$' <<<"$build_job" \
	|| fail "release build job must use read-only contents permission"
rg -q '^    outputs:$' <<<"$build_job" \
	|| fail "release build job must expose release metadata outputs"
rg -q 'version: \$\{\{ steps\.version\.outputs\.version \}\}' <<<"$build_job" \
	|| fail "release build job must expose the computed version"
rg -q 'tag: \$\{\{ steps\.version\.outputs\.tag \}\}' <<<"$build_job" \
	|| fail "release build job must expose the computed tag"
rg -q 'commit: \$\{\{ github\.sha \}\}' <<<"$build_job" \
	|| fail "release build job must expose the exact verified source commit"
if rg -q 'gh release create' <<<"$build_job"; then
	fail "release build job must not publish"
fi

rg -q '^    needs: build$' <<<"$publish_job" \
	|| fail "release publish job must depend on the build job"
rg -q '^    permissions:$' <<<"$publish_job" \
	|| fail "release publish job must declare permissions"
rg -q '^      contents: write$' <<<"$publish_job" \
	|| fail "release publish job must be the only write-permission job"
rg -q 'GH_REPO: \$\{\{ github\.repository \}\}' <<<"$publish_job" \
	|| fail "release publish job must target the current repository without checkout"
if rg -q 'actions/checkout' <<<"$publish_job"; then
	fail "release publish job must not check out or build repository code"
fi
if rg -q 'task (test|ios:sentry|android:sentry|package)' <<<"$publish_job"; then
	fail "release publish job must not run builds, tests, or packaging with write permission"
fi

rg -q -U -- '- name: Build Apple Sentry artifacts\n        env:\n          GH_TOKEN: \$\{\{ github\.token \}\}\n        run: task ios:sentry' \
	<<<"$build_job" \
	|| fail "Apple native build must receive GH_TOKEN explicitly"
rg -q -U -- '- name: Verify Apple Sentry runtime\n        env:\n          GH_TOKEN: \$\{\{ github\.token \}\}\n          FOUNDRYOBSERVABILITY_STRICT_NATIVE_RUNTIME: "1"\n        run: scripts/test-project' \
	<<<"$build_job" \
	|| fail "release build must strictly verify the Apple Sentry runtime"
rg -q 'actions/upload-artifact@v7\.0\.1([[:space:]]|$)' <<<"$build_job" \
	|| fail "release build job must upload finished archives with upload-artifact@v7.0.1"
rg -q 'actions/download-artifact@v8\.0\.1([[:space:]]|$)' <<<"$publish_job" \
	|| fail "release publish job must download archives with download-artifact@v8.0.1"
rg -q 'dist/FoundryObservability-\$\{\{ needs\.build\.outputs\.version \}\}\.zip' \
	<<<"$publish_job" \
	|| fail "release publish job must publish the downloaded core archive"
rg -q 'dist/FoundryObservabilitySentry-\$\{\{ needs\.build\.outputs\.version \}\}\.zip' \
	<<<"$publish_job" \
	|| fail "release publish job must publish the downloaded Sentry archive"
rg -q -- '--target "\$\{\{ needs\.build\.outputs\.commit \}\}"' <<<"$publish_job" \
	|| fail "release publish job must target the exact commit verified by the build job"

rg -q '^  contents: read$' "$pr_workflow" \
	|| fail "pull-request workflow must request read-only contents permission"
rg -q '^      bump:$' "$release_workflow" \
	|| fail "release workflow must expose a bump input"
for level in patch minor major; do
	rg -q "^[[:space:]]+- $level$" "$release_workflow" \
		|| fail "release workflow must offer $level"
done
rg -q 'GITHUB_OUTPUT' "$release_workflow" \
	|| fail "release workflow must compute its version through GITHUB_OUTPUT"
rg -q 'gh release create' "$release_workflow" \
	|| fail "release workflow must publish a GitHub release"

rg -q 'actions/setup-java@v5\.6\.0([[:space:]]|$)' "$release_workflow" \
	|| fail "release workflow must set up Java 17 for Android"
rg -q 'android-actions/setup-android@v4\.0\.1([[:space:]]|$)' "$release_workflow" \
	|| fail "release workflow must set up the Android SDK"
rg -q "java-version: ['\"]?17['\"]?" "$release_workflow" \
	|| fail "release workflow must use Java 17 for Android"
rg -q 'sdkmanager --licenses' "$release_workflow" \
	|| fail "release workflow must accept Android SDK licenses"
rg -q 'platforms;android-36' "$release_workflow" \
	|| fail "release workflow must install Android SDK Platform 36"
rg -q 'chmod \+x addons/FoundryObservabilitySentry/AndroidFoundryObservabilitySentry/gradlew' \
	"$release_workflow" \
	|| fail "release workflow must make the Android Gradle wrapper executable"

release_ios_line=$(awk '/task ios:sentry/{ print NR; exit }' "$release_workflow")
release_apple_runtime_line=$(awk '/FOUNDRYOBSERVABILITY_STRICT_NATIVE_RUNTIME/{ print NR; exit }' "$release_workflow")
release_android_line=$(awk '/task android:sentry/{ print NR; exit }' "$release_workflow")
release_package_line=$(awk '/REQUIRE_NATIVE_ARTIFACTS=1 task package/{ print NR; exit }' "$release_workflow")
release_verify_line=$(awk '/task verify:sentry-package/{ print NR; exit }' "$release_workflow")
release_upload_line=$(awk '/actions\/upload-artifact@v7\.0\.1/{ print NR; exit }' "$release_workflow")
release_download_line=$(awk '/actions\/download-artifact@v8\.0\.1/{ print NR; exit }' "$release_workflow")
release_publish_line=$(awk '/gh release create/{ print NR; exit }' "$release_workflow")
[[ -n "$release_ios_line" && -n "$release_apple_runtime_line" \
	&& -n "$release_android_line" \
	&& -n "$release_package_line" && -n "$release_verify_line" \
	&& -n "$release_upload_line" && -n "$release_download_line" \
	&& -n "$release_publish_line" ]] \
	|| fail "release workflow must build, package, verify, and publish native Sentry artifacts"
(( release_ios_line < release_apple_runtime_line \
	&& release_apple_runtime_line < release_android_line \
	&& release_android_line < release_package_line \
	&& release_package_line < release_verify_line \
	&& release_verify_line < release_upload_line \
	&& release_upload_line < release_download_line \
	&& release_download_line < release_publish_line )) \
	|| fail "release native artifact steps are out of order"

rg -q 'dist/FoundryObservability-\$\{\{ steps\.version\.outputs\.version \}\}\.zip' \
	"$release_workflow" \
	|| fail "release workflow must publish the versioned core archive"
rg -q 'dist/FoundryObservabilitySentry-\$\{\{ steps\.version\.outputs\.version \}\}\.zip' \
	"$release_workflow" \
	|| fail "release workflow must publish the versioned Sentry archive"

for job_id in validate-core build-apple build-android; do
	if rg -q '^    needs:' <<<"$(extract_job "$job_id")"; then
		fail "$job_id must run independently without needs"
	fi
done

rg -Fxq '    name: Validate FoundryObservability' <<<"$core_job" \
	|| fail "validate-core job must preserve the Validate FoundryObservability check context"
rg -Fxq '    runs-on: macos-26' <<<"$core_job" \
	|| fail "validate-core job must run on macos-26"
rg -Fxq '        uses: actions/checkout@v7.0.1' <<<"$core_job" \
	|| fail "validate-core job must use actions/checkout@v7.0.1"
rg -Fxq '        run: brew install prek ripgrep' <<<"$core_job" \
	|| fail "validate-core job must install prek and ripgrep"
rg -Fxq '        uses: go-task/setup-task@v2.1.0' <<<"$core_job" \
	|| fail "validate-core job must use go-task/setup-task@v2.1.0"
rg -Fxq '        uses: actions/setup-go@v7.0.0' <<<"$core_job" \
	|| fail "validate-core job must use actions/setup-go@v7.0.0"
rg -Fq 'go install github.com/cafecito-games/foundry-tools/cmd/anvil@176f5f7c5909c07c785fe6e1fd21051e0c13c5bf' \
	<<<"$core_job" \
	|| fail "validate-core job must pin Anvil to the immutable v0.0.1 commit"
if rg -q 'foundry-tools/cmd/anvil@latest' <<<"$core_job"; then
	fail "validate-core job must not install Anvil from a mutable latest reference"
fi
rg -Fxq '      FOUNDRY_VERSION: "v0.1.0-alpha.7"' <<<"$core_job" \
	|| fail "validate-core job must pin Foundry v0.1.0-alpha.7"
rg -Fq 'https://github.com/cafecito-games/Foundry/releases/download/${FOUNDRY_VERSION}/${asset}' \
	<<<"$core_job" \
	|| fail "validate-core job must download the pinned Foundry editor"
rg -Fq 'unzip -q "$foundry_dir/$asset" -d "$foundry_dir"' <<<"$core_job" \
	|| fail "validate-core job must install the downloaded Foundry editor"
rg -Fq '"$FOUNDRY_BIN" --headless project import --project test_project' \
	<<<"$core_job" \
	|| fail "validate-core job must use command-first project import"
rg -Fxq '        run: task test:core' <<<"$core_job" \
	|| fail "validate-core job must run task test:core"
for forbidden_task in \
	test \
	test:sentry-apple \
	test:sentry-android \
	ios:sentry \
	android:sentry; do
	if job_mentions_task_name "$core_job" "$forbidden_task"; then
		fail "validate-core job must not mention forbidden task name $forbidden_task"
	fi
done

rg -Fxq '    name: Build Apple Sentry addon' <<<"$apple_job" \
	|| fail "build-apple job must be named Build Apple Sentry addon"
rg -Fxq '    runs-on: macos-26' <<<"$apple_job" \
	|| fail "build-apple job must run on macos-26"
rg -Fxq '        uses: actions/checkout@v7.0.1' <<<"$apple_job" \
	|| fail "build-apple job must use actions/checkout@v7.0.1"
rg -Fxq '        run: task test:sentry-apple' <<<"$apple_job" \
	|| fail "build-apple job must run task test:sentry-apple"
for forbidden_task in \
	test \
	test:core \
	test:sentry-android \
	android:sentry; do
	if job_mentions_task_name "$apple_job" "$forbidden_task"; then
		fail "build-apple job must not mention forbidden task name $forbidden_task"
	fi
done
rg -q -U -- '^      - name: Build Apple artifacts$\n^        env:$\n^          GH_TOKEN: \$\{\{ github\.token \}\}$\n^        run: task ios:sentry$' \
	<<<"$apple_job" \
	|| fail "build-apple job must build Apple artifacts with GH_TOKEN"
rg -Fxq '        run: brew install ripgrep xcodegen' <<<"$apple_job" \
	|| fail "build-apple job must install XcodeGen via brew"
rg -Fxq '        uses: go-task/setup-task@v2.1.0' <<<"$apple_job" \
	|| fail "build-apple job must use go-task/setup-task@v2.1.0"

rg -Fxq '    name: Build Android Sentry addon' <<<"$android_job" \
	|| fail "build-android job must be named Build Android Sentry addon"
rg -Fxq '    runs-on: ubuntu-latest' <<<"$android_job" \
	|| fail "build-android job must run on ubuntu-latest"
rg -Fxq '        uses: actions/checkout@v7.0.1' <<<"$android_job" \
	|| fail "build-android job must use actions/checkout@v7.0.1"
rg -Fxq '        run: sudo apt-get update && sudo apt-get install --yes ripgrep' \
	<<<"$android_job" \
	|| fail "build-android job must install ripgrep"
rg -Fxq '        run: task test:sentry-android' <<<"$android_job" \
	|| fail "build-android job must run task test:sentry-android"
rg -Fxq '        run: task android:sentry' <<<"$android_job" \
	|| fail "build-android job must build the Android Sentry AARs"
for forbidden_task in \
	test \
	test:core \
	test:sentry-apple \
	ios:sentry; do
	if job_mentions_task_name "$android_job" "$forbidden_task"; then
		fail "build-android job must not mention forbidden task name $forbidden_task"
	fi
done

rg -q '^        uses: actions/setup-java@v5\.6\.0$' <<<"$android_job" \
	|| fail "build-android job must set up Java 17"
rg -q '^        uses: android-actions/setup-android@v4\.0\.1$' <<<"$android_job" \
	|| fail "build-android job must set up the Android SDK"
rg -Fxq '        uses: go-task/setup-task@v2.1.0' <<<"$android_job" \
	|| fail "build-android job must use go-task/setup-task@v2.1.0"
rg -q "^          java-version: ['\"]?17['\"]?$" <<<"$android_job" \
	|| fail "build-android job must use Java 17"
rg -q '^          (yes \| )?sdkmanager --licenses([[:space:]]|$)' <<<"$android_job" \
	|| fail "build-android job must accept Android SDK licenses"
rg -q "^          sdkmanager ['\"]platforms;android-36['\"]$" <<<"$android_job" \
	|| fail "build-android job must install Android SDK Platform 36"
rg -q '^        run: chmod \+x addons/FoundryObservabilitySentry/AndroidFoundryObservabilitySentry/gradlew$' \
	<<<"$android_job" \
	|| fail "build-android job must make the Android Gradle wrapper executable"

core_test_line=$(job_line "$core_job" 'run: task test:core')
core_tooling_line=$(job_line "$core_job" 'run: brew install prek ripgrep')
core_task_setup_line=$(job_line "$core_job" 'uses: go-task/setup-task@v2.1.0')
core_go_line=$(job_line "$core_job" 'uses: actions/setup-go@v7.0.0')
core_anvil_line=$(job_line "$core_job" 'foundry-tools/cmd/anvil@176f5f7c5909c07c785fe6e1fd21051e0c13c5bf')
core_download_line=$(job_line "$core_job" 'Foundry/releases/download/')
core_install_line=$(job_line "$core_job" 'unzip -q')
core_import_line=$(job_line "$core_job" '--headless project import --project test_project')
for core_setup_line in \
	"$core_tooling_line" \
	"$core_task_setup_line" \
	"$core_go_line" \
	"$core_anvil_line" \
	"$core_download_line" \
	"$core_install_line" \
	"$core_import_line"; do
	(( core_setup_line < core_test_line )) \
		|| fail "validate-core setup must run before task test:core"
done

apple_tooling_line=$(job_line "$apple_job" 'run: brew install ripgrep xcodegen')
apple_task_setup_line=$(job_line "$apple_job" 'uses: go-task/setup-task@v2.1.0')
apple_test_line=$(job_line "$apple_job" 'run: task test:sentry-apple')
apple_build_line=$(job_line "$apple_job" 'run: task ios:sentry')
(( apple_tooling_line < apple_test_line \
	&& apple_task_setup_line < apple_test_line \
	&& apple_test_line < apple_build_line )) \
	|| fail "build-apple tooling, validation, and build steps are out of order"

android_tooling_line=$(job_line "$android_job" 'run: sudo apt-get update')
android_java_line=$(job_line "$android_job" 'uses: actions/setup-java@v5.6.0')
android_sdk_line=$(job_line "$android_job" 'uses: android-actions/setup-android@v4.0.1')
android_platform_line=$(job_line "$android_job" 'sdkmanager "platforms;android-36"')
android_task_setup_line=$(job_line "$android_job" 'uses: go-task/setup-task@v2.1.0')
android_chmod_line=$(job_line "$android_job" 'run: chmod +x addons/FoundryObservabilitySentry/AndroidFoundryObservabilitySentry/gradlew')
android_test_line=$(job_line "$android_job" 'run: task test:sentry-android')
android_build_line=$(job_line "$android_job" 'run: task android:sentry')
(( android_tooling_line < android_test_line \
	&& android_java_line < android_test_line \
	&& android_sdk_line < android_test_line \
	&& android_platform_line < android_test_line \
	&& android_task_setup_line < android_test_line \
	&& android_chmod_line < android_test_line \
	&& android_test_line < android_build_line )) \
	|| fail "build-android setup, validation, and build steps are out of order"

echo "CI workflow contract checks passed"
