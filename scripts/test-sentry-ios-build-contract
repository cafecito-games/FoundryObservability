#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

fail() {
	echo "FAIL: $*" >&2
	exit 1
}

taskfile="$repo_root/Taskfile.yml"
native_root="$repo_root/addons/FoundryObservabilitySentry/FoundryObservabilitySentry"
project_yml="$native_root/project.yml"
pbxproj="$native_root/FoundryObservabilitySentry.xcodeproj/project.pbxproj"
swift_sources="$native_root/Sources/FoundryObservabilitySentry"
tests="$native_root/Tests/FoundryObservabilitySentryTests"
descriptor="$repo_root/addons/FoundryObservabilitySentry/FoundryObservabilitySentry.foundryextension"
export_plugin="$repo_root/addons/FoundryObservabilitySentry/export_plugin.fs"
package_swift="$native_root/Package.swift"
packages_manifest="$repo_root/test_project/packages.toml"
packages_lock="$repo_root/test_project/packages.lock"
gitignore="$repo_root/.gitignore"
readme="$repo_root/README.md"
project_test="$repo_root/scripts/test-project"

[[ -f "$taskfile" ]] || fail "Taskfile.yml is missing"
[[ -f "$project_yml" ]] || fail "Sentry project.yml is missing"
[[ -f "$pbxproj" ]] || fail "generated Sentry Xcode project is missing"
[[ -f "$descriptor" ]] || fail "Sentry FoundryExtension descriptor is missing"
[[ -f "$export_plugin" ]] || fail "Sentry export plugin is missing"
[[ -f "$package_swift" ]] || fail "Sentry Package.swift is missing"
[[ -f "$packages_manifest" ]] || fail "test project packages.toml is missing"
[[ -f "$packages_lock" ]] || fail "test project packages.lock is missing"
[[ -x "$project_test" ]] || fail "project runtime test is missing or not executable"
[[ -f "$swift_sources/FoundryObservabilitySentry.swift" ]] || fail "Sentry bridge source is missing"
[[ -f "$swift_sources/SentryEventMapper.swift" ]] || fail "Sentry mapper source is missing"
[[ -f "$tests/SentryEventMapperTests.swift" ]] || fail "Sentry mapper tests are missing"

rg -q 'platform=iOS' "$taskfile" || fail "Taskfile must build an iOS device framework"
rg -q 'platform=iOS Simulator' "$taskfile" || fail "Taskfile must build an iOS simulator framework"
rg -q 'ARCHS=arm64 CODE_SIGNING_ALLOWED=NO' "$taskfile" \
	|| fail "Taskfile must disable simulator code signing"
rg -q 'xcodebuild -create-xcframework' "$taskfile" \
	|| fail "Taskfile must create an iOS xcframework"
rg -q 'xcodebuild clean' "$taskfile" \
	|| fail "Taskfile must clean stale native build intermediates"
rg -q 'FoundryObservabilitySentry\.xcframework' "$taskfile" \
	|| fail "Taskfile must create the Sentry xcframework"
rg -q 'Foundry-Swift-Binary' "$project_yml" \
	|| fail "native project must use Foundry-Swift-Binary"
rg -q 'exactVersion: 0\.1\.0-alpha\.2' "$project_yml" \
	|| fail "native project must pin Foundry-Swift alpha.2"
rg -q 'exactVersion: 9\.23\.0' "$project_yml" \
	|| fail "native project must pin Sentry Cocoa 9.23.0"
rg -q 'exact: "9\.23\.0"' "$package_swift" \
	|| fail "SwiftPM mapper tests must pin Sentry Cocoa 9.23.0"
rg -q 'GENERATE_INFOPLIST_FILE = YES' "$pbxproj" \
	|| fail "generated Xcode project is missing generated Info.plist settings"
expected_foundryswift_runpath='@loader_path/../../../../../../FoundrySwift/bin/macos_arm64'
rg -Fq "$expected_foundryswift_runpath" "$project_yml" \
	|| fail "native project must resolve the sibling FoundrySwift addon from Versions/A"
rg -Fq "$expected_foundryswift_runpath" "$pbxproj" \
	|| fail "generated Xcode project must preserve the sibling FoundrySwift runpath"

rg -q '^\[packages\.FoundrySwift\]$' "$packages_manifest" \
	|| fail "test project must pin the FoundrySwift companion addon"
for package_field in \
	'source = "github-release"' \
	'repo = "cafecito-games/Foundry-Swift"' \
	'version = "0.1.0-alpha.2"' \
	'asset = "FoundrySwift-0.1.0-alpha.2.zip"' \
	'checksum = "51fedac51e9157430df2e3802dbb0c827c5d35500af418bb1fcb04114d040ffb"' \
	'source_path = "addons/FoundrySwift"'; do
	rg -Fq "$package_field" "$packages_manifest" \
		|| fail "FoundrySwift package is missing exact field: $package_field"
done
foundryswift_lock=$(
	awk '
		/^  \[packages\.FoundrySwift\]$/ { in_section = 1; next }
		in_section && /^  \[packages\./ { exit }
		in_section { print }
	' "$packages_lock"
)
for lock_field in \
	'    resolved_version = "0.1.0-alpha.2"' \
	'    source_path = "addons/FoundrySwift"' \
	'    checksum = "51fedac51e9157430df2e3802dbb0c827c5d35500af418bb1fcb04114d040ffb"' \
	'    spec_hash = "00b367e9ec6319ed1ef0523f11252e55ac0833690932a99b457bba1fa1d3bddc"'; do
	rg -Fxq "$lock_field" <<<"$foundryswift_lock" \
		|| fail "FoundrySwift lock entry is missing exact field: $lock_field"
done
rg -q '^test_project/addons/FoundrySwift/$' "$gitignore" \
	|| fail "installed FoundrySwift test addon must be ignored"
rg -q 'FoundrySwift-0\.1\.0-alpha\.2\.zip' "$readme" \
	|| fail "README must show the exact compatible FoundrySwift release asset"
rg -Fq 'checksum = "51fedac51e9157430df2e3802dbb0c827c5d35500af418bb1fcb04114d040ffb"' "$readme" \
	|| fail "README must show the published FoundrySwift archive checksum"
rg -q 'FoundrySwiftEmbed' "$readme" \
	|| fail "README must explain shared runtime ownership by FoundrySwiftEmbed"
rg -Fq -U $'Android uses the Sentry Android AAR and does not\nrequire the FoundrySwift companion addon.' "$readme" \
	|| fail "README must state that Android does not require FoundrySwift"

rg -q 'FOUNDRYOBSERVABILITY_STRICT_NATIVE_RUNTIME' "$project_test" \
	|| fail "project test must expose strict native runtime verification"
rg -Fq -U $'run_project_tests 2>&1 | tee "$runtime_log"\n\tpipeline_status=("${PIPESTATUS[@]}")' "$project_test" \
	|| fail "strict runtime verification must immediately snapshot every Bash 3.2 pipeline status"
rg -Fq 'foundry_status=${pipeline_status[0]}' "$project_test" \
	|| fail "strict runtime verification must read Foundry status from the pipeline snapshot"
rg -Fq 'tee_status=${pipeline_status[1]}' "$project_test" \
	|| fail "strict runtime verification must read tee status from the pipeline snapshot"
rg -Fq 'strict native runtime Foundry tests failed with status $foundry_status' "$project_test" \
	|| fail "strict runtime verification must report Foundry failure distinctly"
rg -Fq 'strict native runtime output capture failed with status $tee_status' "$project_test" \
	|| fail "strict runtime verification must report tee failure distinctly"
rg -Fq 'foundryswift_plugin="$project_dir/addons/FoundrySwift/plugin.cfg"' "$project_test" \
	|| fail "strict runtime verification must inspect the installed FoundrySwift plugin"
rg -Fq 'rg -q '\''^version="0\.1\.0-alpha\.2"$'\'' "$foundryswift_plugin"' "$project_test" \
	|| fail "strict runtime verification must require the exact installed FoundrySwift version"

set +e
/bin/bash -c 'exit 23' | /bin/bash -c 'exit 37'
pipeline_probe_status=("${PIPESTATUS[@]}")
set -e
[[ ${#pipeline_probe_status[@]} -eq 2 \
	&& ${pipeline_probe_status[0]} -eq 23 \
	&& ${pipeline_probe_status[1]} -eq 37 ]] \
	|| fail "Bash 3.2 pipeline status snapshot must preserve both command failures"

for loader_marker in \
	"Can't open dynamic library" \
	"Can't open FoundryExtension dynamic library" \
	"Error loading extension" \
	"FoundryObservabilitySentry" \
	"FoundrySwift"; do
	rg -Fq "$loader_marker" "$project_test" \
		|| fail "strict runtime verification must reject loader diagnostic: $loader_marker"
done

rg -q '#initFoundryExtension' "$swift_sources/FoundryObservabilitySentry.swift" \
	|| fail "bridge source must register the Foundry entry point"
rg -q 'foundry_observability_sentry_entry_point' "$swift_sources/FoundryObservabilitySentry.swift" \
	|| fail "bridge source has the wrong entry symbol"
rg -q '@Foundry' "$swift_sources/FoundryObservabilitySentry.swift" \
	|| fail "bridge source must expose a Foundry class"
rg -q '@Callable' "$swift_sources/FoundryObservabilitySentry.swift" \
	|| fail "bridge source must expose callable bridge methods"
rg -q 'captureLog' "$swift_sources/FoundryObservabilitySentry.swift" \
	|| fail "bridge source must expose structured log capture"
rg -q 'captureBreadcrumb' "$swift_sources/FoundryObservabilitySentry.swift" \
	|| fail "bridge source must expose breadcrumb capture"
rg -q 'Breadcrumb()' "$swift_sources/SentryEventMapper.swift" \
	|| fail "bridge source must construct Sentry breadcrumbs"
rg -q 'SentrySDK\.addBreadcrumb' "$swift_sources/FoundryObservabilitySentry.swift" \
	|| fail "bridge source must submit Sentry breadcrumbs"
rg -q 'sentryLevel' "$swift_sources/SentryEventMapper.swift" \
	|| fail "bridge source must map breadcrumb levels"
rg -q 'foundry\.timestamp_msec' "$swift_sources/SentryEventMapper.swift" \
	|| fail "breadcrumb data must preserve its normalized timestamp"
rg -q 'enableLogs' "$swift_sources/FoundryObservabilitySentry.swift" \
	|| fail "bridge source must configure Sentry Logs"
rg -q 'SentrySDK\.logger' "$swift_sources/FoundryObservabilitySentry.swift" \
	|| fail "bridge source must use the Sentry structured logger"
rg -q 'captureMetric' "$swift_sources/FoundryObservabilitySentry.swift" \
	|| fail "bridge source must expose custom metric capture"
rg -q 'enableMetrics' "$swift_sources/FoundryObservabilitySentry.swift" \
	|| fail "bridge source must configure Sentry Metrics"
for metric in count gauge distribution; do
	rg -q "SentrySDK\\.metrics\\.${metric}" "$swift_sources/FoundryObservabilitySentry.swift" \
		|| fail "bridge source is missing the ${metric} mapping"
done
for level in trace debug info warn error fatal; do
	rg -q "SentrySDK\.logger\.${level}" "$swift_sources/FoundryObservabilitySentry.swift" \
		|| fail "bridge source is missing the ${level} structured log mapping"
done

for variant in ios.debug ios.release ios.simulator.debug ios.simulator.release; do
	rg -q "^${variant}[[:space:]]*=" "$descriptor" \
		|| fail "descriptor is missing ${variant}"
	rg -q "^${variant}[[:space:]]*=[[:space:]]*\{\}" "$descriptor" \
		|| fail "descriptor ${variant} dependencies must be an empty map"
done
rg -q 'FoundryObservabilitySentry\.xcframework' "$descriptor" "$export_plugin" \
	|| fail "descriptor and export plugin must reference the Sentry xcframework"
if rg -q 'FoundrySwift' "$descriptor" "$export_plugin"; then
	fail "Sentry descriptor/export plugin must not own FoundrySwift"
fi
rg -q 'get_os_name\(\) == "iOS"' "$export_plugin" \
	|| fail "Sentry export plugin must be iOS-only"

rg -q '^macos\.arm64[[:space:]]*=' "$descriptor" \
	|| fail "descriptor must declare macOS arm64"
rg -q '^macos\.arm64[[:space:]]*=[[:space:]]*\{\}' "$descriptor" \
	|| fail "macOS dependencies must be an empty map"
rg -q 'generic/platform=macOS' "$taskfile" \
	|| fail "Taskfile must build a macOS framework"
rg -q 'bin/macos_arm64/FoundryObservabilitySentry\.framework' "$taskfile" \
	|| fail "Taskfile must copy the macOS framework"

echo "Sentry iOS build contract tests passed"
