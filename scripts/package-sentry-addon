#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
sentry_source="$repo_root/addons/FoundryObservabilitySentry"
source_version=$(awk -F'"' '/^version=/{print $2; exit}' "$sentry_source/plugin.cfg")
version="${VERSION:-$source_version}"
dist_dir="${DIST_DIR:-$repo_root/dist}"

fail() {
	echo "FAIL: $*" >&2
	exit 1
}

[[ -d "$sentry_source" ]] || fail "Sentry addon directory is missing"
[[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] \
	|| fail "version must be numeric semver: $version"

if [[ "${REQUIRE_NATIVE_ARTIFACTS:-0}" == "1" ]]; then
	required_native_files=(
		"bin/ios/FoundryObservabilitySentry.xcframework/Info.plist"
		"bin/ios/FoundryObservabilitySentry.xcframework/ios-arm64/FoundryObservabilitySentry.framework/FoundryObservabilitySentry"
		"bin/ios/FoundryObservabilitySentry.xcframework/ios-arm64-simulator/FoundryObservabilitySentry.framework/FoundryObservabilitySentry"
		"bin/macos_arm64/FoundryObservabilitySentry.framework/Versions/A/FoundryObservabilitySentry"
		"bin/android/debug/FoundryObservabilitySentry-debug.aar"
		"bin/android/release/FoundryObservabilitySentry-release.aar"
	)
	for relative_path in "${required_native_files[@]}"; do
		[[ -s "$sentry_source/$relative_path" ]] \
			|| fail "required native artifact is missing or empty: $relative_path"
	done
fi

tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/foundryobservability-sentry-package.XXXXXX")
trap 'rm -rf "$tmp_dir"' EXIT
mkdir -p "$tmp_dir/addons/FoundryObservabilitySentry"
find "$sentry_source" -maxdepth 1 -type f \
	! -name '*.fs' ! -name '*.fs.uid' \
	-exec cp {} "$tmp_dir/addons/FoundryObservabilitySentry/" \;
while IFS= read -r source_resource; do
	relative_resource=${source_resource#"$sentry_source/"}
	destination_resource="$tmp_dir/addons/FoundryObservabilitySentry/$relative_resource"
	mkdir -p "$(dirname "$destination_resource")"
	cp "$source_resource" "$destination_resource"
done < <(
	find "$sentry_source" -type f \
		\( -name '*.fs' -o -name '*.fs.uid' \) \
		| sort
)
for artifact_dir in ios macos_arm64 android/debug android/release; do
	mkdir -p "$tmp_dir/addons/FoundryObservabilitySentry/bin/$artifact_dir"
	cp -R "$sentry_source/bin/$artifact_dir/." \
		"$tmp_dir/addons/FoundryObservabilitySentry/bin/$artifact_dir/"
done

if [[ "$version" != "$source_version" ]]; then
	awk -v version="$version" '
		/^version="/ { print "version=\"" version "\""; next }
		{ print }
	' "$sentry_source/plugin.cfg" >"$tmp_dir/addons/FoundryObservabilitySentry/plugin.cfg"
fi

find "$tmp_dir" -name '.DS_Store' -delete
mkdir -p "$dist_dir"
dist_dir=$(cd "$dist_dir" && pwd)
archive="$dist_dir/FoundryObservabilitySentry-${version}.zip"
rm -f "$archive"
(
	cd "$tmp_dir"
	zip -qry "$archive" addons/FoundryObservabilitySentry
)

echo "$archive"
