#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
sentry_package_script="$repo_root/scripts/package-sentry-addon"
sentry_package_verifier="$repo_root/scripts/verify-sentry-package"
crash_helper="$repo_root/scripts/trigger-test-native-crash"
taskfile="$repo_root/Taskfile.yml"

fail() {
	echo "FAIL: $*" >&2
	exit 1
}

rg -q 'REQUIRE_NATIVE_ARTIFACTS' "$sentry_package_script" \
	|| fail "Sentry packaging must support required native artifacts"
[[ -x "$sentry_package_verifier" ]] \
	|| fail "Sentry package verifier is missing or not executable"
[[ -x "$crash_helper" ]] \
	|| fail "native crash validation helper is missing or not executable"
rg -Fq -- '--i-understand-this-will-crash' "$crash_helper" \
	|| fail "native crash helper must require explicit confirmation"
rg -Fq 'kill -ABRT -- "$pid"' "$crash_helper" \
	|| fail "native crash helper must use an explicit macOS abort signal"
rg -Fq 'adb shell run-as "$package" kill -6 "$pid"' "$crash_helper" \
	|| fail "native crash helper must signal only the resolved debuggable Android package"
rg -q '^  verify:sentry-package:' "$taskfile" \
	|| fail "Taskfile.yml must expose Sentry package verification"
for dist_aware_script in \
	"$repo_root/scripts/package-addon" \
	"$sentry_package_script" \
	"$sentry_package_verifier"; do
	rg -q 'DIST_DIR' "$dist_aware_script" \
		|| fail "$(basename "$dist_aware_script") must support an isolated DIST_DIR"
done
rg -q 'zip -qry' "$sentry_package_script" \
	|| fail "Sentry packaging must preserve framework symlinks with Info-ZIP -y"
rg -q 'readlink' "$sentry_package_verifier" \
	|| fail "Sentry package verification must validate framework symlink targets"
rg -q 'unzip -tq.*aar' "$sentry_package_verifier" \
	|| fail "Sentry package verification must validate nested AAR zip files"

required_native_paths=(
	"bin/ios/FoundryObservabilitySentry.xcframework/Info.plist"
	"bin/ios/FoundryObservabilitySentry.xcframework/ios-arm64/FoundryObservabilitySentry.framework/FoundryObservabilitySentry"
	"bin/ios/FoundryObservabilitySentry.xcframework/ios-arm64-simulator/FoundryObservabilitySentry.framework/FoundryObservabilitySentry"
	"bin/macos_arm64/FoundryObservabilitySentry.framework/Versions/A/FoundryObservabilitySentry"
	"bin/android/debug/FoundryObservabilitySentry-debug.aar"
	"bin/android/release/FoundryObservabilitySentry-release.aar"
)
for native_path in "${required_native_paths[@]}"; do
	rg -Fq "$native_path" "$sentry_package_script" \
		|| fail "Sentry packaging does not require $native_path"
	rg -Fq "addons/FoundryObservabilitySentry/$native_path" "$sentry_package_verifier" \
		|| fail "Sentry package verification does not inspect $native_path"
done

probe_root=$(mktemp -d "${TMPDIR:-/tmp}/foundryobservability-package-contract.XXXXXX")
probe_artifact="$repo_root/addons/FoundryObservabilitySentry/bin/android/debug/FoundryObservabilitySentry-debug.aar"
native_requirement_probe_version="9.8.6"
native_requirement_dist="$probe_root/native-requirement"
probe_backup_dir=""
restore_probe_artifact() {
	if [[ -n "$probe_backup_dir" && -e "$probe_backup_dir/FoundryObservabilitySentry-debug.aar" ]]; then
		mv "$probe_backup_dir/FoundryObservabilitySentry-debug.aar" "$probe_artifact"
	fi
}
cleanup_probes() {
	restore_probe_artifact
	rm -rf "$probe_root"
}
trap cleanup_probes EXIT

fake_adb_dir="$probe_root/fake-adb"
fake_adb_log="$probe_root/fake-adb.log"
mkdir -p "$fake_adb_dir"
cat >"$fake_adb_dir/adb" <<'FAKE_ADB'
#!/usr/bin/env bash
set -euo pipefail

printf '%s\n' "$*" >>"$FAKE_ADB_LOG"
if [[ ${1:-} == "shell" && ${2:-} == "pidof" ]]; then
	printf '%s' "${FAKE_ADB_PIDOF_OUTPUT:-}"
	exit "${FAKE_ADB_PIDOF_STATUS:-0}"
fi
if [[ ${1:-} == "shell" && ${2:-} == "run-as" ]]; then
	exit 0
fi
exit 64
FAKE_ADB
chmod +x "$fake_adb_dir/adb"

if ambiguous_crash_output=$(
	PATH="$fake_adb_dir:$PATH" \
		FAKE_ADB_LOG="$fake_adb_log" \
		FAKE_ADB_PIDOF_OUTPUT="2468 3579" \
		"$crash_helper" \
			android \
			com.example.foundrygame \
			--i-understand-this-will-crash 2>&1
); then
	fail "native crash helper accepted ambiguous Android package PIDs"
fi
rg -Fq 'multiple Android processes match package com.example.foundrygame' \
	<<<"$ambiguous_crash_output" \
	|| fail "native crash helper did not explain ambiguous Android package PIDs"
if rg -Fq 'shell run-as' "$fake_adb_log"; then
	fail "native crash helper signaled an Android process after ambiguous PID resolution"
fi

: >"$fake_adb_log"
if missing_crash_output=$(
	PATH="$fake_adb_dir:$PATH" \
		FAKE_ADB_LOG="$fake_adb_log" \
		FAKE_ADB_PIDOF_OUTPUT="" \
		"$crash_helper" \
			android \
			com.example.foundrygame \
			--i-understand-this-will-crash 2>&1
); then
	fail "native crash helper accepted a missing Android package PID"
fi
rg -Fq 'Android package is not running: com.example.foundrygame' \
	<<<"$missing_crash_output" \
	|| fail \
		"native crash helper did not explain a missing Android package PID: $missing_crash_output"
if rg -Fq 'shell run-as' "$fake_adb_log"; then
	fail "native crash helper signaled an Android process without a resolved PID"
fi

: >"$fake_adb_log"
PATH="$fake_adb_dir:$PATH" \
	FAKE_ADB_LOG="$fake_adb_log" \
	FAKE_ADB_PIDOF_OUTPUT=$'2468\r\n' \
	"$crash_helper" \
		android \
		com.example.foundrygame \
		--i-understand-this-will-crash >/dev/null
grep -Fxq 'shell pidof com.example.foundrygame' "$fake_adb_log" \
	|| fail "native crash helper did not query all exact package-name PIDs"
grep -Fxq 'shell run-as com.example.foundrygame kill -6 2468' "$fake_adb_log" \
	|| fail "native crash helper did not signal the one exact Android package PID"

if [[ -e "$probe_artifact" ]]; then
	probe_backup_dir="$probe_root/artifact-backup"
	mkdir -p "$probe_backup_dir"
	mv "$probe_artifact" "$probe_backup_dir/FoundryObservabilitySentry-debug.aar"
fi
if native_failure=$(
	cd "$repo_root"
	DIST_DIR="$native_requirement_dist" \
		REQUIRE_NATIVE_ARTIFACTS=1 \
		task package VERSION="$native_requirement_probe_version" 2>&1
); then
	fail "required-native Sentry packaging succeeded with a missing artifact"
fi
rg -q 'required native artifact is missing or empty' <<<"$native_failure" \
	|| fail "required-native Sentry packaging failed for an unexpected reason"
restore_probe_artifact

rg -q 'capture_log' "$repo_root/docs/API.md" \
	|| fail "API docs are missing capture_log"
rg -q 'capture_feedback' "$repo_root/docs/API.md" \
	|| fail "API docs are missing capture_feedback"
rg -q 'ObservabilityFeedback' "$repo_root/docs/API.md" \
	|| fail "API docs are missing ObservabilityFeedback"
rg -q 'logs_enabled' "$repo_root/docs/API.md" \
	|| fail "API docs are missing logs_enabled"
for metric_api in capture_metric capture_counter capture_gauge capture_distribution; do
	rg -q "$metric_api" "$repo_root/docs/API.md" \
		|| fail "API docs are missing $metric_api"
done
rg -q 'metric_sample_rate' "$repo_root/docs/API.md" \
	|| fail "API docs are missing metric_sample_rate"
rg -q 'metric_filter' "$repo_root/docs/API.md" \
	|| fail "API docs are missing metric_filter"
rg -q 'Apple.*Android|Android.*Apple' "$repo_root/docs/API.md" \
	|| fail "API docs are missing Apple and Android provider behavior"
rg -q 'Automatic runtime context' "$repo_root/docs/API.md" \
	|| fail "API docs are missing automatic runtime context"
rg -q 'send_default_pii' "$repo_root/docs/API.md" \
	|| fail "API docs are missing runtime context privacy behavior"
api_docs="$repo_root/docs/API.md"
observability_user_section=$(
	sed -n '/^## ObservabilityUser$/,/^## ObservabilityScope$/p' "$api_docs"
)
observability_scope_section=$(
	sed -n '/^## ObservabilityScope$/,/^## ObservabilityCaptureMask$/p' "$api_docs"
)
[[ -n "$observability_user_section" ]] \
	|| fail "API docs are missing the ObservabilityUser section"
[[ -n "$observability_scope_section" ]] \
	|| fail "API docs are missing the ObservabilityScope section"
rg -q 'max_breadcrumbs' "$repo_root/docs/API.md" \
	|| fail "API docs are missing max_breadcrumbs"
for user_signature in \
	'func application_user_id() -> String' \
	'func display_name() -> String' \
	'func contact_email() -> String' \
	'func is_valid() -> bool'; do
	grep -Fqx "$user_signature" <<<"$observability_user_section" \
		|| fail "ObservabilityUser docs are missing exact signature: $user_signature"
done
for scope_signature in \
	'func tags() -> Dictionary' \
	'func contexts() -> Dictionary' \
	'func set_tag(key: String, value: String) -> bool' \
	'func remove_tag(key: String) -> bool' \
	'func clear_tags() -> void' \
	'func set_context(name: String, value: Dictionary) -> bool' \
	'func remove_context(name: String) -> bool' \
	'func clear_contexts() -> void' \
	'func is_empty() -> bool' \
	'func duplicate() -> ObservabilityScope'; do
	grep -Fqx "$scope_signature" <<<"$observability_scope_section" \
		|| fail "ObservabilityScope docs are missing exact signature: $scope_signature"
done
for scope_method in set_user remove_user clear_breadcrumbs; do
	rg -q "func ${scope_method}\\(" "$repo_root/docs/API.md" \
		|| fail "API docs are missing $scope_method"
done
provider_outline=$(sed -n '/^class_name MyProvider$/,/^~~~$/p' "$repo_root/docs/API.md")
grep -qx 'func clear_breadcrumbs() -> bool:' <<<"$provider_outline" \
	|| fail "custom provider example is missing clear_breadcrumbs"

memory_provider_docs=$(
	sed -n '/^### MemoryObservabilityProvider$/,/^## Diagnostic attachments$/p' \
		"$repo_root/docs/API.md"
)
memory_provider_docs_flat=$(tr '\n\t' '  ' <<<"$memory_provider_docs" | tr -s ' ')
for memory_attachment_contract in \
	'func captured_attachments() -> Array[Array]' \
	'`captured_attachments()` returns deep defensive snapshots aligned one-to-one with captured events.' \
	'`clear()` clears captured events, scopes, and attachment history but retains the live session attachment set.'; do
	rg -Fq "$memory_attachment_contract" <<<"$memory_provider_docs_flat" \
		|| fail "Memory provider docs are missing attachment contract: $memory_attachment_contract"
done

attachment_docs=$(
	sed -n '/^## Diagnostic attachments$/,/^## FoundryLib integration$/p' \
		"$repo_root/docs/API.md"
)
[[ -n "$attachment_docs" ]] \
	|| fail "API docs are missing the bounded Diagnostic attachments section"
attachment_docs_flat=$(tr '\n\t' '  ' <<<"$attachment_docs" | tr -s ' ')
for attachment_signature in \
	'static func from_path(path: String, filename: String = "", content_type: String = "", category: StringName = DEFAULT_CATEGORY) -> ObservabilityAttachment?' \
	'static func from_bytes(bytes: PackedByteArray, filename: String, content_type: String = "", category: StringName = DEFAULT_CATEGORY) -> ObservabilityAttachment?' \
	'func path() -> String' \
	'func bytes() -> PackedByteArray' \
	'func filename() -> String' \
	'func effective_filename() -> String' \
	'func content_type() -> String' \
	'func category() -> StringName' \
	'func is_path() -> bool' \
	'func is_bytes() -> bool' \
	'func duplicate() -> ObservabilityAttachment' \
	'func is_valid() -> bool' \
	'func handle() -> String' \
	'func reason() -> StringName' \
	'func error() -> int' \
	'func duplicate() -> ObservabilityAttachmentFailure' \
	'func add_attachment(attachment: ObservabilityAttachment) -> String' \
	'func remove_attachment(handle: String) -> bool' \
	'func clear_attachments() -> bool' \
	'func last_attachment_failures() -> Array' \
	'abstract func remove_attachment(handle: String) -> int'; do
	rg -Fq "$attachment_signature" <<<"$attachment_docs_flat" \
		|| fail "API docs are missing exact attachment signature: $attachment_signature"
done
for attachment_config_contract in \
	'max_attachment_bytes | `20 * 1024 * 1024` (20 MiB)' \
	'attach_game_log | `false`' \
	'attach_screenshot | `false`' \
	'attach_scene_tree | `false`' \
	'Negative values normalize to zero.' \
	'Zero disables all attachment delivery, while attachment management may continue.' \
	'The limit applies independently to each attachment.'; do
	rg -Fq "$attachment_config_contract" <<<"$attachment_docs_flat" \
		|| fail "API docs are missing attachment configuration contract: $attachment_config_contract"
done
for attachment_lifecycle_contract in \
	'Attachments persist for the configured provider session until removed or cleared.' \
	'Successful reconfiguration, provider replacement, and shutdown invalidate every prior handle.' \
	'Failed reconfiguration preserves attachments and their handles.' \
	'Absolute paths and `user://` paths stay lazy until capture.' \
	'Packaged `res://` paths are materialized only for the current Foundry-originated event.' \
	'Byte attachments are copied on construction and access.' \
	'Partial attachment failures never reject an accepted event.' \
	'`last_error()` remains `Error.OK` after an accepted event with attachment failures.' \
	'Only the latest event envelope replaces `last_attachment_failures()`.' \
	'Non-event APIs and automatic structured logs do not replace the latest attachment failures.'; do
	rg -Fq "$attachment_lifecycle_contract" <<<"$attachment_docs_flat" \
		|| fail "API docs are missing attachment lifecycle contract: $attachment_lifecycle_contract"
done
for failure_reason in missing_file unreadable_file oversized platform_unavailable provider_rejected; do
	rg -Fq "\`$failure_reason\`" <<<"$attachment_docs_flat" \
		|| fail "API docs are missing stable attachment failure reason: $failure_reason"
done
for builtin_contract in \
	'`attach_game_log`, `attach_screenshot`, and `attach_scene_tree` are independent, false-by-default opt-ins.' \
	'The game log remains a lazy path attachment.' \
	'Screenshot capture runs on the main thread, is unavailable headlessly, and may reuse the current frame.' \
	'Scene-tree output is bounded and may contain game-authored names or text.' \
	'Game logs and screenshots may contain sensitive data.' \
	'Screenshot and scene-tree collection can affect frame time.' \
	'Scene-tree collection requires the main thread and an initialized scene tree.' \
	'Capture-time screenshots and scene-tree snapshots do not accompany recovered native crashes.' \
	'Foundry preflight runs independently for each event.' \
	'Apple and Android are the supported native attachment targets.' \
	'User-supplied byte attachments, absolute and globalized `user://` paths, and the persistent game log are mirrored to the Apple and Android Sentry global scope.' \
	'They may accompany native crashes, Apple app hangs, and Android ANRs.' \
	'Only materialized `res://` bytes and capture-time screenshot or scene-tree snapshots remain capture-local.' \
	'The native SDK owns diagnostic timing and the final attachment race.'; do
	rg -Fq "$builtin_contract" <<<"$attachment_docs_flat" \
		|| fail "API docs are missing built-in attachment contract: $builtin_contract"
done
rg -Fq 'user://logs/foundry.log' "$repo_root/README.md" \
	|| fail "README is missing the provider-neutral attachment example"
rg -Fq 'FoundryObservability.last_attachment_failures()' "$repo_root/README.md" \
	|| fail "README attachment example must inspect delivery failures"
rg -Fq 'FoundryObservability.remove_attachment(handle)' "$repo_root/README.md" \
	|| fail "README attachment example must remove its handle"
rg -Fq 'issue #12' "$repo_root/CHANGELOG.md" \
	|| fail "changelog is missing the diagnostic attachment entry for issue #12"

command -v unzip >/dev/null 2>&1 || fail "unzip is required"
default_dist="$probe_root/default"
archive=$(DIST_DIR="$default_dist" "$repo_root/scripts/package-addon")
sentry_archive=$(DIST_DIR="$default_dist" "$repo_root/scripts/package-sentry-addon")
listing=$(unzip -Z1 "$archive")
sentry_listing=$(unzip -Z1 "$sentry_archive")

if rg -n -i 'trigger.*crash|crash.*trigger|bad[_-]?code|native-crash-validation' \
	<<<"$listing"$'\n'"$sentry_listing"; then
	fail "package contains deliberate crash validation tooling"
fi

grep -qx 'addons/FoundryObservability/plugin.cfg' <<<"$listing" \
	|| fail "package is missing plugin.cfg"
grep -qx 'addons/FoundryObservability/FoundryObservability.fs' <<<"$listing" \
	|| fail "package is missing the autoload"
grep -qx 'addons/FoundryObservability/FoundryObservabilityApi.fs' <<<"$listing" \
	|| fail "package is missing the public contract marker"
grep -qx 'addons/FoundryObservability/ObservabilityStartupStatus.fs' <<<"$listing" \
	|| fail "package is missing startup status constants"
grep -qx 'addons/FoundryObservability/ObservabilityStartupSettings.fs' <<<"$listing" \
	|| fail "package is missing startup settings resolution"
for scope_resource in \
	ObservabilityUser ObservabilityScope ObservabilityScopeProvider; do
	resource_path="addons/FoundryObservability/${scope_resource}.fs"
	grep -qx "$resource_path" <<<"$listing" \
		|| fail "package is missing ${scope_resource}.fs"
	grep -qx "$resource_path.uid" <<<"$listing" \
		|| fail "package is missing ${scope_resource}.fs.uid"
done
for attachment_resource in \
	ObservabilityAttachment \
	ObservabilityAttachmentFailure \
	ObservabilityAttachmentsProvider; do
	resource_path="addons/FoundryObservability/${attachment_resource}.fs"
	grep -qx "$resource_path" <<<"$listing" \
		|| fail "package is missing ${attachment_resource}.fs"
	grep -qx "$resource_path.uid" <<<"$listing" \
		|| fail "package is missing ${attachment_resource}.fs.uid"
done
grep -qx 'addons/FoundryObservability/ObservabilityFeedback.fs' <<<"$listing" \
	|| fail "package is missing the feedback value type"
grep -qx 'addons/FoundryObservability/ObservabilityMetric.fs' <<<"$listing" \
	|| fail "package is missing the metric value type"
grep -qx 'addons/FoundryObservability/ObservabilityMetricType.fs' <<<"$listing" \
	|| fail "package is missing the metric type constants"
grep -qx 'addons/FoundryObservability/ObservabilityMetricsProvider.fs' <<<"$listing" \
	|| fail "package is missing the optional metrics provider contract"
grep -qx 'addons/FoundryObservability/foundrylib/FoundryLibObservabilitySink.fs' <<<"$listing" \
	|| fail "package is missing the FoundryLib observability sink"

if grep -q '^addons/FoundryObservabilityFoundryLib/' <<<"$listing"; then
	fail "package contains the removed FoundryLib integration addon"
fi

if rg -n '(^|/)(test_project|\.foundry|\.git|\.build)(/|$)|\.DS_Store$' <<<"$listing"; then
	fail "package contains repository or generated state"
fi

while IFS= read -r resource; do
	relative=${resource#"$repo_root/"}
	grep -qx "$relative.uid" <<<"$listing" \
		|| fail "$relative.uid is missing from the package"
done < <(
	find "$repo_root/addons/FoundryObservability" -type f -name '*.fs' | sort
)

grep -qx 'addons/FoundryObservabilitySentry/plugin.cfg' <<<"$sentry_listing" \
	|| fail "Sentry package is missing plugin.cfg"
grep -qx 'addons/FoundryObservabilitySentry/SentryObservabilityProvider.fs' <<<"$sentry_listing" \
	|| fail "Sentry package is missing the FoundryScript provider"
for context_resource in SentryRuntimeContextProbe SentryRuntimeContextCollector; do
	grep -qx "addons/FoundryObservabilitySentry/${context_resource}.fs" \
		<<<"$sentry_listing" \
		|| fail "Sentry package is missing ${context_resource}.fs"
done
for attachment_resource in \
	SentryAttachmentRuntimeProbe \
	SentryBuiltInAttachmentCollector; do
	resource_path="addons/FoundryObservabilitySentry/${attachment_resource}.fs"
	grep -qx "$resource_path" <<<"$sentry_listing" \
		|| fail "Sentry package is missing ${attachment_resource}.fs"
	grep -qx "$resource_path.uid" <<<"$sentry_listing" \
		|| fail "Sentry package is missing ${attachment_resource}.fs.uid"
done
grep -qx 'addons/FoundryObservabilitySentry/FoundryObservabilitySentry.foundryextension' <<<"$sentry_listing" \
	|| fail "Sentry package is missing the FoundryExtension descriptor"
grep -qx 'addons/FoundryObservabilitySentry/bin/ios/.gitkeep' <<<"$sentry_listing" \
	|| fail "Sentry package is missing the iOS artifact directory"
grep -qx 'addons/FoundryObservabilitySentry/bin/macos_arm64/.gitkeep' <<<"$sentry_listing" \
	|| fail "Sentry package is missing the macOS artifact directory"
grep -qx 'addons/FoundryObservabilitySentry/bin/android/debug/.gitkeep' <<<"$sentry_listing" \
	|| fail "Sentry package is missing the Android debug artifact directory"
grep -qx 'addons/FoundryObservabilitySentry/bin/android/release/.gitkeep' <<<"$sentry_listing" \
	|| fail "Sentry package is missing the Android release artifact directory"
grep -qx 'addons/FoundryObservabilitySentry/android-dependencies.txt' <<<"$sentry_listing" \
	|| fail "Sentry package is missing Android dependency coordinates"

if grep -q 'addons/FoundryObservabilitySentry/FoundryObservabilitySentry/' <<<"$sentry_listing"; then
	fail "Sentry package contains SwiftPM source or generated project state"
fi
if rg -n '(^|/)(test_project|\.foundry|\.git|\.build|\.swiftpm|xcuserdata)(/|$)|\.DS_Store$' <<<"$sentry_listing"; then
	fail "Sentry package contains repository or generated state"
fi

while IFS= read -r resource; do
	relative=${resource#"$repo_root/"}
	grep -qx "$relative.uid" <<<"$sentry_listing" \
		|| fail "$relative.uid is missing from the Sentry package"
done < <(
	find "$repo_root/addons/FoundryObservabilitySentry" -maxdepth 1 -type f -name '*.fs' | sort
)

probe_version="9.8.7"
sentry_only_probe_version="9.8.8"
version_dist="$probe_root/version"
probe_core_archive="$version_dist/FoundryObservability-${probe_version}.zip"
probe_sentry_archive="$version_dist/FoundryObservabilitySentry-${probe_version}.zip"
probe_sentry_only_archive="$version_dist/FoundryObservabilitySentry-${sentry_only_probe_version}.zip"
(
	cd "$repo_root"
	DIST_DIR="$version_dist" task package VERSION="$probe_version" >/dev/null
)
[[ -s "$probe_core_archive" ]] \
	|| fail "task package did not create the requested core archive version"
[[ -s "$probe_sentry_archive" ]] \
	|| fail "task package did not create the requested Sentry archive version"
unzip -p "$probe_core_archive" addons/FoundryObservability/plugin.cfg \
	| grep -qx "version=\"$probe_version\"" \
	|| fail "task package did not rewrite the core plugin version"
unzip -p "$probe_sentry_archive" addons/FoundryObservabilitySentry/plugin.cfg \
	| grep -qx "version=\"$probe_version\"" \
	|| fail "task package did not rewrite the Sentry plugin version"
(
	cd "$repo_root"
	DIST_DIR="$version_dist" task package:sentry VERSION="$sentry_only_probe_version" >/dev/null
)
[[ -s "$probe_sentry_only_archive" ]] \
	|| fail "task package:sentry did not create the requested archive version"
unzip -p "$probe_sentry_only_archive" addons/FoundryObservabilitySentry/plugin.cfg \
	| grep -qx "version=\"$sentry_only_probe_version\"" \
	|| fail "task package:sentry did not rewrite the Sentry plugin version"

source_framework="$repo_root/addons/FoundryObservabilitySentry/bin/macos_arm64/FoundryObservabilitySentry.framework"
if [[ -L "$source_framework/Versions/Current" ]]; then
	symlink_extract="$probe_root/symlink-extract"
	unzip -q "$sentry_archive" -d "$symlink_extract"
	archive_framework="$symlink_extract/addons/FoundryObservabilitySentry/bin/macos_arm64/FoundryObservabilitySentry.framework"
	[[ -L "$archive_framework/Versions/Current" ]] \
		|| fail "Sentry package did not preserve Versions/Current as a symlink"
	[[ "$(readlink "$archive_framework/Versions/Current")" == "A" ]] \
		|| fail "Sentry package preserved an incorrect Versions/Current target"
	for framework_link in FoundryObservabilitySentry Headers Modules Resources; do
		[[ -L "$archive_framework/$framework_link" ]] \
			|| fail "Sentry package did not preserve $framework_link as a symlink"
	done
fi

echo "Package contract checks passed: $archive and $sentry_archive"
