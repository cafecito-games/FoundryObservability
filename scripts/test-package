#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

fail() {
	echo "FAIL: $*" >&2
	exit 1
}

command -v unzip >/dev/null 2>&1 || fail "unzip is required"
archive=$("$repo_root/scripts/package-addon")
sentry_archive=$("$repo_root/scripts/package-sentry-addon")
listing=$(unzip -Z1 "$archive")
sentry_listing=$(unzip -Z1 "$sentry_archive")

grep -qx 'addons/FoundryObservability/plugin.cfg' <<<"$listing" \
	|| fail "package is missing plugin.cfg"
grep -qx 'addons/FoundryObservability/FoundryObservability.fs' <<<"$listing" \
	|| fail "package is missing the autoload"
grep -qx 'addons/FoundryObservability/FoundryObservabilityApi.fs' <<<"$listing" \
	|| fail "package is missing the public contract marker"
grep -qx 'addons/FoundryObservability/foundrylib/FoundryLibObservabilitySink.fs' <<<"$listing" \
	|| fail "package is missing the FoundryLib observability sink"

if grep -q '^addons/FoundryObservabilityFoundryLib/' <<<"$listing"; then
	fail "package contains the removed FoundryLib integration addon"
fi

if rg -n '(^|/)(test_project|\.foundry|\.git|\.build)(/|$)|\.DS_Store$' <<<"$listing"; then
	fail "package contains repository or generated state"
fi

while IFS= read -r resource; do
	relative=${resource#"$repo_root/"}
	grep -qx "$relative.uid" <<<"$listing" \
		|| fail "$relative.uid is missing from the package"
done < <(
	find "$repo_root/addons/FoundryObservability" -type f -name '*.fs' | sort
)

grep -qx 'addons/FoundryObservabilitySentry/plugin.cfg' <<<"$sentry_listing" \
	|| fail "Sentry package is missing plugin.cfg"
grep -qx 'addons/FoundryObservabilitySentry/SentryObservabilityProvider.fs' <<<"$sentry_listing" \
	|| fail "Sentry package is missing the FoundryScript provider"
grep -qx 'addons/FoundryObservabilitySentry/FoundryObservabilitySentry.foundryextension' <<<"$sentry_listing" \
	|| fail "Sentry package is missing the FoundryExtension descriptor"
grep -qx 'addons/FoundryObservabilitySentry/bin/ios/.gitkeep' <<<"$sentry_listing" \
	|| fail "Sentry package is missing the iOS artifact directory"
grep -qx 'addons/FoundryObservabilitySentry/bin/macos_arm64/.gitkeep' <<<"$sentry_listing" \
	|| fail "Sentry package is missing the macOS artifact directory"
grep -qx 'addons/FoundryObservabilitySentry/bin/android/debug/.gitkeep' <<<"$sentry_listing" \
	|| fail "Sentry package is missing the Android debug artifact directory"
grep -qx 'addons/FoundryObservabilitySentry/bin/android/release/.gitkeep' <<<"$sentry_listing" \
	|| fail "Sentry package is missing the Android release artifact directory"
grep -qx 'addons/FoundryObservabilitySentry/android-dependencies.txt' <<<"$sentry_listing" \
	|| fail "Sentry package is missing Android dependency coordinates"

if grep -q 'addons/FoundryObservabilitySentry/FoundryObservabilitySentry/' <<<"$sentry_listing"; then
	fail "Sentry package contains SwiftPM source or generated project state"
fi
if rg -n '(^|/)(test_project|\.foundry|\.git|\.build|\.swiftpm|xcuserdata)(/|$)|\.DS_Store$' <<<"$sentry_listing"; then
	fail "Sentry package contains repository or generated state"
fi

while IFS= read -r resource; do
	relative=${resource#"$repo_root/"}
	grep -qx "$relative.uid" <<<"$sentry_listing" \
		|| fail "$relative.uid is missing from the Sentry package"
done < <(
	find "$repo_root/addons/FoundryObservabilitySentry" -maxdepth 1 -type f -name '*.fs' | sort
)

echo "Package contract checks passed: $archive and $sentry_archive"
