#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
sentry_package_script="$repo_root/scripts/package-sentry-addon"
sentry_package_verifier="$repo_root/scripts/verify-sentry-package"
taskfile="$repo_root/Taskfile.yml"

fail() {
	echo "FAIL: $*" >&2
	exit 1
}

rg -q 'REQUIRE_NATIVE_ARTIFACTS' "$sentry_package_script" \
	|| fail "Sentry packaging must support required native artifacts"
[[ -x "$sentry_package_verifier" ]] \
	|| fail "Sentry package verifier is missing or not executable"
rg -q '^  verify:sentry-package:' "$taskfile" \
	|| fail "Taskfile.yml must expose Sentry package verification"

required_native_paths=(
	"bin/ios/FoundryObservabilitySentry.xcframework/Info.plist"
	"bin/ios/FoundryObservabilitySentry.xcframework/ios-arm64/FoundryObservabilitySentry.framework/FoundryObservabilitySentry"
	"bin/ios/FoundryObservabilitySentry.xcframework/ios-arm64-simulator/FoundryObservabilitySentry.framework/FoundryObservabilitySentry"
	"bin/macos_arm64/FoundryObservabilitySentry.framework/Versions/A/FoundryObservabilitySentry"
	"bin/android/debug/FoundryObservabilitySentry-debug.aar"
	"bin/android/release/FoundryObservabilitySentry-release.aar"
)
for native_path in "${required_native_paths[@]}"; do
	rg -Fq "$native_path" "$sentry_package_script" \
		|| fail "Sentry packaging does not require $native_path"
	rg -Fq "addons/FoundryObservabilitySentry/$native_path" "$sentry_package_verifier" \
		|| fail "Sentry package verification does not inspect $native_path"
done

probe_artifact="$repo_root/addons/FoundryObservabilitySentry/bin/android/debug/FoundryObservabilitySentry-debug.aar"
probe_backup_dir=""
restore_probe_artifact() {
	if [[ -n "$probe_backup_dir" && -e "$probe_backup_dir/FoundryObservabilitySentry-debug.aar" ]]; then
		mv "$probe_backup_dir/FoundryObservabilitySentry-debug.aar" "$probe_artifact"
		rmdir "$probe_backup_dir"
	fi
}
if [[ -e "$probe_artifact" ]]; then
	probe_backup_dir=$(mktemp -d "${TMPDIR:-/tmp}/foundryobservability-native-probe.XXXXXX")
	mv "$probe_artifact" "$probe_backup_dir/FoundryObservabilitySentry-debug.aar"
	trap restore_probe_artifact EXIT
fi
if native_failure=$(REQUIRE_NATIVE_ARTIFACTS=1 "$sentry_package_script" 2>&1); then
	fail "required-native Sentry packaging succeeded with a missing artifact"
fi
rg -q 'required native artifact is missing or empty' <<<"$native_failure" \
	|| fail "required-native Sentry packaging failed for an unexpected reason"
restore_probe_artifact
trap - EXIT

rg -q 'capture_log' "$repo_root/docs/API.md" \
	|| fail "API docs are missing capture_log"
rg -q 'capture_feedback' "$repo_root/docs/API.md" \
	|| fail "API docs are missing capture_feedback"
rg -q 'ObservabilityFeedback' "$repo_root/docs/API.md" \
	|| fail "API docs are missing ObservabilityFeedback"
rg -q 'logs_enabled' "$repo_root/docs/API.md" \
	|| fail "API docs are missing logs_enabled"
for metric_api in capture_metric capture_counter capture_gauge capture_distribution; do
	rg -q "$metric_api" "$repo_root/docs/API.md" \
		|| fail "API docs are missing $metric_api"
done
rg -q 'metric_sample_rate' "$repo_root/docs/API.md" \
	|| fail "API docs are missing metric_sample_rate"
rg -q 'metric_filter' "$repo_root/docs/API.md" \
	|| fail "API docs are missing metric_filter"
rg -q 'Apple.*Android|Android.*Apple' "$repo_root/docs/API.md" \
	|| fail "API docs are missing Apple and Android provider behavior"

command -v unzip >/dev/null 2>&1 || fail "unzip is required"
archive=$("$repo_root/scripts/package-addon")
sentry_archive=$("$repo_root/scripts/package-sentry-addon")
listing=$(unzip -Z1 "$archive")
sentry_listing=$(unzip -Z1 "$sentry_archive")

grep -qx 'addons/FoundryObservability/plugin.cfg' <<<"$listing" \
	|| fail "package is missing plugin.cfg"
grep -qx 'addons/FoundryObservability/FoundryObservability.fs' <<<"$listing" \
	|| fail "package is missing the autoload"
grep -qx 'addons/FoundryObservability/FoundryObservabilityApi.fs' <<<"$listing" \
	|| fail "package is missing the public contract marker"
grep -qx 'addons/FoundryObservability/ObservabilityFeedback.fs' <<<"$listing" \
	|| fail "package is missing the feedback value type"
grep -qx 'addons/FoundryObservability/ObservabilityMetric.fs' <<<"$listing" \
	|| fail "package is missing the metric value type"
grep -qx 'addons/FoundryObservability/ObservabilityMetricType.fs' <<<"$listing" \
	|| fail "package is missing the metric type constants"
grep -qx 'addons/FoundryObservability/ObservabilityMetricsProvider.fs' <<<"$listing" \
	|| fail "package is missing the optional metrics provider contract"
grep -qx 'addons/FoundryObservability/foundrylib/FoundryLibObservabilitySink.fs' <<<"$listing" \
	|| fail "package is missing the FoundryLib observability sink"

if grep -q '^addons/FoundryObservabilityFoundryLib/' <<<"$listing"; then
	fail "package contains the removed FoundryLib integration addon"
fi

if rg -n '(^|/)(test_project|\.foundry|\.git|\.build)(/|$)|\.DS_Store$' <<<"$listing"; then
	fail "package contains repository or generated state"
fi

while IFS= read -r resource; do
	relative=${resource#"$repo_root/"}
	grep -qx "$relative.uid" <<<"$listing" \
		|| fail "$relative.uid is missing from the package"
done < <(
	find "$repo_root/addons/FoundryObservability" -type f -name '*.fs' | sort
)

grep -qx 'addons/FoundryObservabilitySentry/plugin.cfg' <<<"$sentry_listing" \
	|| fail "Sentry package is missing plugin.cfg"
grep -qx 'addons/FoundryObservabilitySentry/SentryObservabilityProvider.fs' <<<"$sentry_listing" \
	|| fail "Sentry package is missing the FoundryScript provider"
grep -qx 'addons/FoundryObservabilitySentry/FoundryObservabilitySentry.foundryextension' <<<"$sentry_listing" \
	|| fail "Sentry package is missing the FoundryExtension descriptor"
grep -qx 'addons/FoundryObservabilitySentry/bin/ios/.gitkeep' <<<"$sentry_listing" \
	|| fail "Sentry package is missing the iOS artifact directory"
grep -qx 'addons/FoundryObservabilitySentry/bin/macos_arm64/.gitkeep' <<<"$sentry_listing" \
	|| fail "Sentry package is missing the macOS artifact directory"
grep -qx 'addons/FoundryObservabilitySentry/bin/android/debug/.gitkeep' <<<"$sentry_listing" \
	|| fail "Sentry package is missing the Android debug artifact directory"
grep -qx 'addons/FoundryObservabilitySentry/bin/android/release/.gitkeep' <<<"$sentry_listing" \
	|| fail "Sentry package is missing the Android release artifact directory"
grep -qx 'addons/FoundryObservabilitySentry/android-dependencies.txt' <<<"$sentry_listing" \
	|| fail "Sentry package is missing Android dependency coordinates"

if grep -q 'addons/FoundryObservabilitySentry/FoundryObservabilitySentry/' <<<"$sentry_listing"; then
	fail "Sentry package contains SwiftPM source or generated project state"
fi
if rg -n '(^|/)(test_project|\.foundry|\.git|\.build|\.swiftpm|xcuserdata)(/|$)|\.DS_Store$' <<<"$sentry_listing"; then
	fail "Sentry package contains repository or generated state"
fi

while IFS= read -r resource; do
	relative=${resource#"$repo_root/"}
	grep -qx "$relative.uid" <<<"$sentry_listing" \
		|| fail "$relative.uid is missing from the Sentry package"
done < <(
	find "$repo_root/addons/FoundryObservabilitySentry" -maxdepth 1 -type f -name '*.fs' | sort
)

echo "Package contract checks passed: $archive and $sentry_archive"
