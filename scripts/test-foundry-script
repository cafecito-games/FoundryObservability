#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
addon="$repo_root/addons/FoundryObservability"
project_dir="$repo_root/test_project"
test_addon="$project_dir/addons/FoundryObservability"
sentry_addon="$repo_root/addons/FoundryObservabilitySentry"
test_sentry_addon="$project_dir/addons/FoundryObservabilitySentry"

fail() {
	echo "FAIL: $*" >&2
	exit 1
}

require_doc_text() {
	local relative_path=$1
	local expected=$2
	local failure_message=$3
	rg -Fq -- "$expected" "$repo_root/$relative_path" \
		|| fail "$failure_message"
}

require_content_text() {
	local content=$1
	local expected=$2
	local failure_message=$3
	rg -Fq -- "$expected" <<<"$content" \
		|| fail "$failure_message"
}

reject_content_text() {
	local content=$1
	local rejected=$2
	local failure_message=$3
	if rg -Fiq -- "$rejected" <<<"$content"; then
		fail "$failure_message"
	fi
}

extract_marked_doc_section() {
	local relative_path=$1
	local marker_name=$2
	awk \
		-v start_marker="<!-- foundry-observability:$marker_name:start -->" \
		-v end_marker="<!-- foundry-observability:$marker_name:end -->" \
		'
		$0 == start_marker {
			start_count += 1
			in_section = 1
			next
		}
		$0 == end_marker {
			end_count += 1
			in_section = 0
			next
		}
		in_section { print }
		END {
			if (start_count != 1 || end_count != 1 || in_section) {
				exit 1
			}
		}
		' "$repo_root/$relative_path"
}

extract_heading_doc_section() {
	local relative_path=$1
	local start_heading=$2
	local end_heading=$3
	awk \
		-v start_heading="$start_heading" \
		-v end_heading="$end_heading" \
		'
		$0 == start_heading {
			found_start = 1
			in_section = 1
		}
		$0 == end_heading && in_section {
			found_end = 1
			exit
		}
		in_section { print }
		END {
			if (!found_start || !found_end) {
				exit 1
			}
		}
		' "$repo_root/$relative_path"
}

resolve_foundry_bin() {
	if [[ -n "${FOUNDRY_BIN:-}" ]]; then
		[[ -x "$FOUNDRY_BIN" ]] || fail "FOUNDRY_BIN is not executable: $FOUNDRY_BIN"
		printf '%s\n' "$FOUNDRY_BIN"
	elif [[ -x "/Users/christian/CafecitoGames/Foundry/bin/foundry.macos.editor.dev.arm64" ]]; then
		printf '%s\n' "/Users/christian/CafecitoGames/Foundry/bin/foundry.macos.editor.dev.arm64"
	elif command -v foundry >/dev/null 2>&1; then
		command -v foundry
	else
		fail "Foundry executable not found; set FOUNDRY_BIN or put foundry on PATH"
	fi
}

command -v rg >/dev/null 2>&1 || fail "ripgrep is required"

[[ -f "$addon/plugin.cfg" ]] || fail "plugin.cfg is missing"
[[ -f "$addon/export_plugin.fs" ]] || fail "export_plugin.fs is missing"
[[ -f "$addon/FoundryObservability.fs" ]] || fail "FoundryObservability.fs is missing"
[[ -f "$addon/FoundryObservabilityApi.fs" ]] || fail "FoundryObservabilityApi.fs is missing"
[[ -f "$addon/ObservabilityStartupStatus.fs" ]] \
	|| fail "ObservabilityStartupStatus.fs is missing"
[[ -f "$addon/ObservabilityStartupSettings.fs" ]] \
	|| fail "ObservabilityStartupSettings.fs is missing"
[[ -f "$addon/AutomaticObservabilityLogger.fs" ]] \
	|| fail "AutomaticObservabilityLogger.fs is missing"
[[ -f "$addon/ObservabilityFeedback.fs" ]] || fail "ObservabilityFeedback.fs is missing"
[[ -f "$addon/ObservabilityBreadcrumb.fs" ]] || fail "ObservabilityBreadcrumb.fs is missing"
[[ -f "$addon/ObservabilityUser.fs" ]] || fail "ObservabilityUser.fs is missing"
[[ -f "$addon/ObservabilityScope.fs" ]] || fail "ObservabilityScope.fs is missing"
[[ -f "$addon/ObservabilityScopeProvider.fs" ]] \
	|| fail "ObservabilityScopeProvider.fs is missing"
[[ -f "$addon/ObservabilityCaptureMask.fs" ]] || fail "ObservabilityCaptureMask.fs is missing"
[[ -f "$addon/ObservabilityBreadcrumbsProvider.fs" ]] \
	|| fail "ObservabilityBreadcrumbsProvider.fs is missing"
[[ -f "$addon/ObservabilityMetric.fs" ]] || fail "ObservabilityMetric.fs is missing"
[[ -f "$addon/ObservabilityStackFrame.fs" ]] || fail "ObservabilityStackFrame.fs is missing"
[[ -f "$addon/ObservabilityMetricType.fs" ]] || fail "ObservabilityMetricType.fs is missing"
[[ -f "$addon/ObservabilityMetricsProvider.fs" ]] || fail "ObservabilityMetricsProvider.fs is missing"
[[ -f "$addon/foundrylib/FoundryLibObservabilitySink.fs" ]] || fail "FoundryLib observability sink is missing"
[[ -f "$sentry_addon/SentryObservabilityProvider.fs" ]] || fail "Sentry provider is missing"
[[ -f "$sentry_addon/SentryRuntimeContextProbe.fs" ]] \
	|| fail "Sentry runtime context probe is missing"
[[ -f "$sentry_addon/SentryRuntimeContextCollector.fs" ]] \
	|| fail "Sentry runtime context collector is missing"
for field in _kind _level _message _source _timestamp_msec _attributes _exception _engine_ticks_msec _scope; do
	rg -q "^final var ${field}:" "$addon/ObservabilityEvent.fs" \
		|| fail "ObservabilityEvent field must be immutable: ${field}"
done
for field in _message _level _category _timestamp_msec _attributes _type; do
	rg -q "^final var ${field}:" "$addon/ObservabilityBreadcrumb.fs" \
		|| fail "ObservabilityBreadcrumb field must be immutable: ${field}"
done
for field in _application_user_id _display_name _contact_email; do
	rg -q "^final var ${field}:" "$addon/ObservabilityUser.fs" \
		|| fail "ObservabilityUser field must be immutable: ${field}"
done
for field in _tags _contexts; do
	rg -q "^final var ${field}:" "$addon/ObservabilityScope.fs" \
		|| fail "ObservabilityScope container reference must be immutable: ${field}"
done
rg -q '^const UNASSIGNED_TIMESTAMP: int = -1$' "$addon/ObservabilityEvent.fs" \
	|| fail "ObservabilityEvent must define the unassigned timestamp sentinel"
rg -q 'p_timestamp_msec: int = UNASSIGNED_TIMESTAMP,' "$addon/ObservabilityEvent.fs" \
	|| fail "ObservabilityEvent timestamp default must use its named sentinel"

rg -q '^name="FoundryObservability"$' "$addon/plugin.cfg" \
	|| fail "plugin.cfg has the wrong addon name"
rg -q '^version="0\.1\.0"$' "$addon/plugin.cfg" \
	|| fail "plugin.cfg must start at version 0.1.0"
rg -q '^namespace foundry\.observability$' "$addon/FoundryObservability.fs" \
	|| fail "autoload has the wrong namespace"
rg -q '^class_name FoundryObservability extends Node$' "$addon/FoundryObservability.fs" \
	|| fail "autoload class declaration is missing"
rg -q '^class_name AutomaticObservabilityLogger$' "$addon/AutomaticObservabilityLogger.fs" \
	|| fail "automatic logger class declaration is missing"
rg -q '^trait_name FoundryObservabilityApi$' "$addon/FoundryObservabilityApi.fs" \
	|| fail "public contract marker is missing"
rg -q '^class_name ObservabilityFeedback$' "$addon/ObservabilityFeedback.fs" \
	|| fail "feedback value type declaration is missing"
rg -q '^class_name ObservabilityBreadcrumb$' "$addon/ObservabilityBreadcrumb.fs" \
	|| fail "breadcrumb value type declaration is missing"
rg -q '^class_name ObservabilityUser$' "$addon/ObservabilityUser.fs" \
	|| fail "user value type declaration is missing"
rg -q '^class_name ObservabilityScope$' "$addon/ObservabilityScope.fs" \
	|| fail "scope value type declaration is missing"
rg -q '^trait_name ObservabilityScopeProvider$' "$addon/ObservabilityScopeProvider.fs" \
	|| fail "optional scope provider contract is missing"
rg -q '^class_name ObservabilityCaptureMask$' "$addon/ObservabilityCaptureMask.fs" \
	|| fail "automatic capture mask declaration is missing"
rg -q '^trait_name ObservabilityBreadcrumbsProvider$' \
	"$addon/ObservabilityBreadcrumbsProvider.fs" \
	|| fail "optional breadcrumb provider contract is missing"
rg -q '^class_name ObservabilityMetric$' "$addon/ObservabilityMetric.fs" \
	|| fail "metric value type declaration is missing"
rg -q '^class_name ObservabilityStackFrame$' "$addon/ObservabilityStackFrame.fs" \
	|| fail "stack frame value type declaration is missing"
rg -q '^class_name ObservabilityMetricType$' "$addon/ObservabilityMetricType.fs" \
	|| fail "metric type declaration is missing"
rg -q '^trait_name ObservabilityMetricsProvider$' "$addon/ObservabilityMetricsProvider.fs" \
	|| fail "optional metrics provider contract is missing"
rg -q 'capture_feedback' "$addon/FoundryObservabilityApi.fs" \
	|| fail "public contract is missing capture_feedback"
rg -q 'add_autoload_singleton\(' "$addon/export_plugin.fs" \
	|| fail "editor plugin does not register the autoload"
rg -q '^namespace foundry\.observability\.foundrylib$' "$addon/foundrylib/FoundryLibObservabilitySink.fs" \
	|| fail "FoundryLib sink has the wrong namespace"
rg -q '^class_name FoundryLibObservabilitySink$' "$addon/foundrylib/FoundryLibObservabilitySink.fs" \
	|| fail "FoundryLib sink class declaration is missing"
rg -q '^uses LogSink$' "$addon/foundrylib/FoundryLibObservabilitySink.fs" \
	|| fail "FoundryLib sink does not implement LogSink"

if rg -n --glob '*.fs' \
	'^(namespace|import) games\.cafecito\.foundryobservability' \
	"$addon" "$project_dir/tests"; then
	fail "current FoundryScript declarations contain the removed namespace"
fi

for current_doc in README.md BUILD.md CONTRIBUTING.md CHANGELOG.md docs/API.md; do
	if rg -n 'games\.cafecito\.foundryobservability' "$repo_root/$current_doc"; then
		fail "current documentation contains the removed namespace: $current_doc"
	fi
done

require_doc_text \
	"README.md" \
	"foundry_observability/startup/auto_init" \
	"README is missing automatic startup setup"

api_doc="docs/API.md"
require_doc_text \
	"$api_doc" \
	"## Project-settings startup" \
	"API documentation is missing the project-settings startup section"
require_doc_text \
	"$api_doc" \
	'The top-level `provider_options` value must be a `Dictionary`.' \
	"API documentation must require a top-level provider options Dictionary"
while IFS=$'\t' read -r setting_name documented_default; do
	require_doc_text \
		"$api_doc" \
		"| \`$setting_name\` | $documented_default |" \
		"API documentation is missing startup setting/default: $setting_name"
done <<'STARTUP_SETTINGS'
foundry_observability/startup/auto_init	`true`
foundry_observability/startup/enabled	`true`
foundry_observability/startup/skip_editor_play	`false`
foundry_observability/startup/skip_debug_exports	`false`
foundry_observability/options/dsn	`""`
foundry_observability/options/environment	`""`
foundry_observability/options/release	`""`
foundry_observability/options/dist	`""`
foundry_observability/options/debug_diagnostics	`2` (`Auto`)
foundry_observability/options/provider_options	`{}`
STARTUP_SETTINGS
for required_api_text in \
	'Nested values may be null, booleans, integers, finite floats, strings, `StringName` values, arrays, or dictionaries.' \
	'Dictionary keys must be strings or `StringName` values.' \
	'eight nested containers' \
	'at most 256 dictionary entries' \
	'before the main scene' \
	'before any autoload ordered after `FoundryObservability`' \
	'Autoloads ordered earlier' \
	'engine work before autoload construction' \
	'When `enabled=false` is reread after successful startup, observability flushes' \
	'Repeating the same disabled settings is idempotent.' \
	'a later `auto_init=false` reread records `disabled`' \
	'Editor, editor-play, and debug-export skip outcomes have the' \
	'same preservation behavior.' \
	'`ObservabilityStartupSettings.capture_enabled()`'
do
	require_doc_text \
		"$api_doc" \
		"$required_api_text" \
		"API documentation is missing startup contract: $required_api_text"
done
while IFS=$'\t' read -r startup_status startup_error; do
	require_doc_text \
		"$api_doc" \
		"| \`$startup_status\` | $startup_error |" \
		"API documentation is missing startup status/error: $startup_status"
done <<'STARTUP_STATUSES'
not_started	`Error.OK`
initialized	`Error.OK`
disabled	`Error.OK`
skipped_editor	`Error.OK`
skipped_editor_play	`Error.OK`
skipped_debug	`Error.OK`
missing_dsn	`Error.ERR_UNCONFIGURED`
provider_unavailable	`Error.ERR_UNAVAILABLE`
configuration_failed	`Error.ERR_INVALID_PARAMETER` or the provider's error
STARTUP_STATUSES
native_crash_doc="docs/NATIVE_CRASH_VALIDATION.md"
if ! automatic_readiness_code=$(
	extract_marked_doc_section \
		"$native_crash_doc" \
		"automatic-native-crash-readiness"
); then
	fail "native crash validation must mark the automatic readiness code fence"
fi
if ! manual_readiness_code=$(
	extract_marked_doc_section \
		"$native_crash_doc" \
		"manual-native-crash-readiness"
); then
	fail "native crash validation must mark the manual readiness code fence"
fi
rg -q -U \
	'(?s)func _automatic_crash_validation_ready\(\) -> bool:.*startup_status\(\).*ObservabilityStartupStatus\.INITIALIZED:.*return false.*if not FoundryObservability\.is_available\(\):.*return false.*return true' \
	<<<"$automatic_readiness_code" \
	|| fail "automatic native crash readiness must connect status and availability failures"
rg -q -U \
	'(?s)func _run_guarded_automatic_crash_validation\(\) -> void:.*if not _automatic_crash_validation_ready\(\):[[:space:]]*return' \
	<<<"$automatic_readiness_code" \
	|| fail "automatic native crash trigger must return behind its readiness guard"
rg -q -U \
	'(?s)func _configure_manual_crash_validation\(\) -> bool:.*FoundryObservability\.configure\(.*if result != Error\.OK:.*return false.*if not FoundryObservability\.is_available\(\):.*return false.*return true' \
	<<<"$manual_readiness_code" \
	|| fail "manual native crash readiness must connect configure and availability failures"
rg -q -U \
	'(?s)func _run_guarded_manual_crash_validation\(\) -> void:.*if not _configure_manual_crash_validation\(\):[[:space:]]*return' \
	<<<"$manual_readiness_code" \
	|| fail "manual native crash trigger must return behind its readiness guard"
for required_native_text in \
	'**Automatic Run A readiness:**' \
	'**Manual Run A readiness:**' \
	'**Automatic Run B readiness:**' \
	'**Manual Run B readiness:**' \
	'startup/auto_init=false' \
	'FoundryObservability.startup_status()' \
	'FoundryObservability.configure(' \
	'FoundryObservability.is_available()' \
	'Do not invoke any platform crash trigger when either readiness function returns false.' \
	'Use the same DSN, release, environment, and distribution in Run A and Run B.' \
	'native backend ownership'
do
	require_doc_text \
		"$native_crash_doc" \
		"$required_native_text" \
		"native crash validation is missing recovery contract: $required_native_text"
done
require_doc_text \
	"README.md" \
	"## Provider-neutral manual quick start" \
	"README must label the provider-neutral manual quick start"
require_doc_text \
	"README.md" \
	'Do not call `configure()` after successful automatic Sentry startup unless replacing the active startup provider is intentional.' \
	"README must warn that manual configure replaces automatic startup"
require_doc_text \
	"$api_doc" \
	'- ObservabilityStartupStatus: stable project-settings startup result constants; see the [startup status table](#skip-decisions-and-results).' \
	"API public index must list ObservabilityStartupStatus"
if ! startup_resolver_section=$(
	extract_heading_doc_section \
		"$api_doc" \
		"## Project-settings startup" \
		"## Public API index"
); then
	fail "API documentation must have a bounded project-settings startup section"
fi
require_content_text \
	"$startup_resolver_section" \
	'Startup only tests whether the trimmed DSN is nonempty; the provider may reject its syntax during configuration.' \
	"API documentation must define the core DSN validation boundary"
for rejected_dsn_claim in \
	"Startup validates DSN syntax" \
	"The core validates DSN syntax" \
	"Project-settings startup validates DSN syntax" \
	"Startup requires a syntactically valid DSN"
do
	reject_content_text \
		"$startup_resolver_section" \
		"$rejected_dsn_claim" \
		"project-settings startup docs must not claim core DSN syntax validation"
done

rg -Fq '"foundry_engine"' "$sentry_addon/SentryRuntimeContextCollector.fs" \
	|| fail "Sentry runtime context must use Foundry engine naming"

materialize_sentry_addon() {
	destination=$1
	mkdir -p "$destination"
	find "$sentry_addon" -maxdepth 1 -type f -exec cp {} "$destination/" \;
	for artifact_dir in ios macos_arm64 android/debug android/release; do
		mkdir -p "$destination/bin/$artifact_dir"
		cp -R "$sentry_addon/bin/$artifact_dir/." \
			"$destination/bin/$artifact_dir/"
	done
}

restore_test_addons() {
	if [[ -d "$test_addon" && ! -L "$test_addon" ]]; then
		rm -rf "$test_addon"
	fi
	if [[ ! -e "$test_addon" ]]; then
		ln -s ../../addons/FoundryObservability "$test_addon"
	fi
	if [[ -d "$test_sentry_addon" && ! -L "$test_sentry_addon" ]]; then
		rm -rf "$test_sentry_addon"
	fi
	if [[ ! -e "$test_sentry_addon" ]]; then
		ln -s ../../addons/FoundryObservabilitySentry "$test_sentry_addon"
	fi
}

trap restore_test_addons EXIT

if [[ -L "$test_addon" ]]; then
	rm "$test_addon"
	cp -R "$addon" "$test_addon"
fi
if [[ -L "$test_sentry_addon" ]]; then
	rm "$test_sentry_addon"
	materialize_sentry_addon "$test_sentry_addon"
elif [[ ! -e "$test_sentry_addon" ]]; then
	materialize_sentry_addon "$test_sentry_addon"
fi

foundry_bin=$(resolve_foundry_bin)
import_log=$(mktemp "${TMPDIR:-/tmp}/foundryobservability-import.XXXXXX")
cleanup() {
	rm -f "$import_log"
	restore_test_addons
}
trap cleanup EXIT

"$foundry_bin" --headless project import --project "$project_dir" >"$import_log" 2>&1 || {
	cat "$import_log" >&2
	fail "Foundry project import failed"
}
if rg -n 'SCRIPT ERROR|Parse Error|Failed to load script' "$import_log"; then
	fail "Foundry import reported script errors"
fi

(
	cd "$project_dir"
	"$foundry_bin" --headless script lint \
		--project "$project_dir" \
		--fail-on=warning \
		addons/FoundryObservability
)
(
	cd "$project_dir"
	"$foundry_bin" --headless script lint \
		--project "$project_dir" \
		--fail-on=warning \
		addons/FoundryObservabilitySentry
)

echo "FoundryScript contract checks passed"
