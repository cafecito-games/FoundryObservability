#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
project_dir="$repo_root/test_project"
core_addon="$project_dir/addons/FoundryObservability"
sentry_addon="$project_dir/addons/FoundryObservabilitySentry"
sentry_source="$repo_root/addons/FoundryObservabilitySentry"
strict_native_runtime="${FOUNDRYOBSERVABILITY_STRICT_NATIVE_RUNTIME:-0}"
runtime_log=""

fail() {
	echo "FAIL: $*" >&2
	exit 1
}

if [[ -n "${FOUNDRY_BIN:-}" ]]; then
	[[ -x "$FOUNDRY_BIN" ]] || fail "FOUNDRY_BIN is not executable: $FOUNDRY_BIN"
	foundry_bin="$FOUNDRY_BIN"
elif [[ -x "/Users/christian/CafecitoGames/Foundry/bin/foundry.macos.editor.dev.arm64" ]]; then
		foundry_bin="/Users/christian/CafecitoGames/Foundry/bin/foundry.macos.editor.dev.arm64"
elif command -v foundry >/dev/null 2>&1; then
		foundry_bin=$(command -v foundry)
else
	fail "Foundry executable not found; set FOUNDRY_BIN or put foundry on PATH"
fi

command -v anvil >/dev/null 2>&1 \
	|| fail "anvil is required; install github.com/cafecito-games/foundry-tools/cmd/anvil"

if [[ "$strict_native_runtime" == "1" ]]; then
	sentry_binary="$sentry_source/bin/macos_arm64/FoundryObservabilitySentry.framework/Versions/A/FoundryObservabilitySentry"
	[[ -s "$sentry_binary" ]] \
		|| fail "strict native runtime verification requires a built macOS Sentry framework"
fi

materialize_sentry_addon() {
	destination=$1
	mkdir -p "$destination"
	find "$sentry_source" -maxdepth 1 -type f -exec cp {} "$destination/" \;
	for artifact_dir in ios macos_arm64 android/debug android/release; do
		mkdir -p "$destination/bin/$artifact_dir"
		cp -R "$sentry_source/bin/$artifact_dir/." \
			"$destination/bin/$artifact_dir/"
	done
}

restore_test_addons() {
	if [[ -n "$runtime_log" && -e "$runtime_log" ]]; then
		rm -f "$runtime_log"
	fi
	if [[ -d "$core_addon" && ! -L "$core_addon" ]]; then
		rm -rf "$core_addon"
	fi
	if [[ ! -e "$core_addon" ]]; then
		ln -s ../../addons/FoundryObservability "$core_addon"
	fi
	if [[ -d "$repo_root/addons/FoundryObservabilitySentry" ]]; then
		if [[ -d "$sentry_addon" && ! -L "$sentry_addon" ]]; then
			rm -rf "$sentry_addon"
		fi
		if [[ ! -e "$sentry_addon" ]]; then
			ln -s ../../addons/FoundryObservabilitySentry "$sentry_addon"
		fi
	fi
}

trap restore_test_addons EXIT

# Foundry's headless source scan intentionally skips directory symlinks. Materialize the local
# addons for the duration of the runtime test, then restore the tracked development symlinks.
if [[ -L "$core_addon" ]]; then
	rm "$core_addon"
	cp -R "$repo_root/addons/FoundryObservability" "$core_addon"
fi
if [[ -L "$sentry_addon" ]]; then
	rm "$sentry_addon"
	materialize_sentry_addon "$sentry_addon"
elif [[ ! -e "$sentry_addon" ]]; then
	materialize_sentry_addon "$sentry_addon"
fi

if [[ "${FOUNDRYOBSERVABILITY_SKIP_ANVIL_INSTALL:-0}" != "1" ]]; then
	anvil pkg install --dir "$project_dir"
fi

run_project_tests() {
	"$foundry_bin" --headless project test \
		--project "$project_dir" \
		--runner res://addons/foundrylib/testlib/cli/run.fs \
		-- --path res://tests
}

if [[ "$strict_native_runtime" == "1" ]]; then
	foundryswift_plugin="$project_dir/addons/FoundrySwift/plugin.cfg"
	[[ -f "$foundryswift_plugin" ]] \
		|| fail "strict native runtime verification requires the installed FoundrySwift plugin"
	rg -q '^version="0\.1\.0-alpha\.2"$' "$foundryswift_plugin" \
		|| fail "strict native runtime verification requires FoundrySwift 0.1.0-alpha.2"
	runtime_log=$(mktemp "${TMPDIR:-/tmp}/foundryobservability-native-runtime.XXXXXX")
	set +e
	run_project_tests 2>&1 | tee "$runtime_log"
	pipeline_status=("${PIPESTATUS[@]}")
	set -e
	foundry_status=${pipeline_status[0]}
	tee_status=${pipeline_status[1]}
	(( tee_status == 0 )) \
		|| fail "strict native runtime output capture failed with status $tee_status"
	(( foundry_status == 0 )) \
		|| fail "strict native runtime Foundry tests failed with status $foundry_status"
	loader_error_pattern="Can't open dynamic library:.*(FoundryObservabilitySentry|FoundrySwift)|Can't open FoundryExtension dynamic library:.*(FoundryObservabilitySentry|FoundrySwift)|Library not loaded:.*(FoundryObservabilitySentry|FoundrySwift)|Error loading extension:.*(FoundryObservabilitySentry|FoundrySwift)"
	if rg -n "$loader_error_pattern" "$runtime_log"; then
		fail "strict native runtime verification detected a native loader error"
	fi
else
	run_project_tests
fi
