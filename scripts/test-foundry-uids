#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

fail() {
	echo "FAIL: $*" >&2
	exit 1
}

source_roots=(
	"$repo_root/addons/FoundryObservability"
	"$repo_root/addons/FoundryObservabilitySentry"
	"$repo_root/test_project/tests"
)

# Generated dependencies under test_project/addons are intentionally outside this contract.
for source_root in "${source_roots[@]}"; do
	[[ -d "$source_root" ]] \
		|| fail "FoundryScript source directory is missing: ${source_root#"$repo_root/"}"
	while IFS= read -r resource; do
		relative_resource=${resource#"$repo_root/"}
		git -C "$repo_root" ls-files --error-unmatch "$relative_resource" >/dev/null 2>&1 \
			|| fail "$relative_resource is not tracked by Git"
		git -C "$repo_root" check-ignore --no-index -q "$relative_resource" \
			&& fail "$relative_resource is ignored by Git"

		uid_file="$resource.uid"
		[[ -f "$uid_file" ]] || fail "missing UID companion for $relative_resource"
		uid=$(<"$uid_file")
		[[ "$uid" =~ ^uid://[a-z0-9]+$ ]] \
			|| fail "invalid UID in ${uid_file#"$repo_root/"}"
		relative_uid=${uid_file#"$repo_root/"}
		git -C "$repo_root" check-ignore --no-index -q "$relative_uid" \
			&& fail "$relative_uid is ignored by Git"
		git -C "$repo_root" ls-files --error-unmatch "$relative_uid" >/dev/null 2>&1 \
			|| fail "$relative_uid is not tracked by Git"
	done < <(find "$source_root" -type f -name '*.fs' | sort)

	while IFS= read -r uid_file; do
		resource=${uid_file%.uid}
		[[ -f "$resource" ]] \
			|| fail "orphan UID companion: ${uid_file#"$repo_root/"}"
	done < <(find "$source_root" -type f -name '*.fs.uid' | sort)
done

echo "Foundry UID contract checks passed"
