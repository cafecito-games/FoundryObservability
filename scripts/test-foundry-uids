#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

fail() {
	echo "FAIL: $*" >&2
	exit 1
}

for addon in \
	"$repo_root/addons/FoundryObservability" \
	"$repo_root/addons/FoundryObservabilityFoundryLib"; do
	[[ -d "$addon" ]] || fail "addon directory is missing: ${addon#"$repo_root/"}"
	while IFS= read -r resource; do
		uid_file="$resource.uid"
		[[ -f "$uid_file" ]] || fail "missing UID companion for ${resource#"$repo_root/"}"
		uid=$(<"$uid_file")
		[[ "$uid" =~ ^uid://[a-z0-9]+$ ]] \
			|| fail "invalid UID in ${uid_file#"$repo_root/"}"
		relative=${uid_file#"$repo_root/"}
		git -C "$repo_root" check-ignore -q "$relative" \
			&& fail "$relative is ignored by Git"
		git -C "$repo_root" ls-files --error-unmatch "$relative" >/dev/null 2>&1 \
			|| fail "$relative is not tracked by Git"
	done < <(find "$addon" -type f -name '*.fs' | sort)
done

echo "Foundry UID contract checks passed"
