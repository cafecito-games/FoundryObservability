#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
provider="$repo_root/addons/FoundryObservabilitySentry/SentryObservabilityProvider.fs"
crash_guide="$repo_root/docs/NATIVE_CRASH_VALIDATION.md"

fail() {
	echo "FAIL: $*" >&2
	exit 1
}

[[ -f "$provider" ]] || fail "Sentry provider is missing"
[[ -f "$crash_guide" ]] || fail "native crash validation guide is missing"
rg -Fqi 'Android' "$crash_guide" \
	|| fail "native crash validation guide must cover Android"
rg -Fqi 'previous launch' "$crash_guide" \
	|| fail "native crash validation guide must cover previous-launch delivery"
rg -Fq -- '--i-understand-this-will-crash' "$crash_guide" \
	|| fail "native crash validation guide must show the guarded helper"
rg -q 'Engine\.has_singleton\(_NATIVE_CLASS\)' "$provider" \
	|| fail "provider must check the Android singleton"
rg -q 'Engine\.get_singleton\(_NATIVE_CLASS\)' "$provider" \
	|| fail "provider must retrieve the Android singleton"
rg -q 'ClassDB\.class_exists\(_NATIVE_CLASS\)' "$provider" \
	|| fail "provider must preserve Apple ClassDB resolution"

android_source="$repo_root/addons/FoundryObservabilitySentry/AndroidFoundryObservabilitySentry"
bridge_source="$android_source/src/main/java/games/cafecito/android/foundryobservabilitysentry/SentryObservabilityBridge.java"
lifecycle_source="$android_source/src/main/java/games/cafecito/android/foundryobservabilitysentry/SentryLifecycleCoordinator.java"
configuration_source="$android_source/src/main/java/games/cafecito/android/foundryobservabilitysentry/SentryLifecycleConfiguration.java"
driver_source="$android_source/src/main/java/games/cafecito/android/foundryobservabilitysentry/AndroidSentrySdkDriver.java"
attachment_mapper="$android_source/src/main/java/games/cafecito/android/foundryobservabilitysentry/SentryAttachmentMapper.java"
attachment_tests="$android_source/src/test/java/games/cafecito/android/foundryobservabilitysentry/SentryAttachmentMapperTest.java"
lifecycle_tests="$android_source/src/test/java/games/cafecito/android/foundryobservabilitysentry/SentryLifecycleCoordinatorTest.java"
breadcrumb_mapper="$android_source/src/main/java/games/cafecito/android/foundryobservabilitysentry/SentryBreadcrumbMapper.java"
breadcrumb_tests="$android_source/src/test/java/games/cafecito/android/foundryobservabilitysentry/SentryBreadcrumbMapperTest.java"
manifest="$android_source/src/main/AndroidManifest.xml"
gradle_file="$android_source/build.gradle"

[[ -d "$android_source" ]] || fail "Android source module is missing"
[[ -f "$bridge_source" ]] || fail "Android bridge source is missing"
[[ -f "$lifecycle_source" ]] || fail "Android lifecycle coordinator is missing"
[[ -f "$configuration_source" ]] || fail "Android lifecycle configuration is missing"
[[ -f "$driver_source" ]] || fail "Android Sentry lifecycle driver is missing"
[[ -f "$attachment_mapper" ]] || fail "Android Sentry attachment mapper is missing"
[[ -f "$attachment_tests" ]] || fail "Android Sentry attachment mapper tests are missing"
[[ -f "$lifecycle_tests" ]] || fail "Android lifecycle coordinator tests are missing"
[[ -f "$breadcrumb_mapper" ]] || fail "Android breadcrumb mapper is missing"
[[ -f "$breadcrumb_tests" ]] || fail "Android breadcrumb mapper tests are missing"
[[ -f "$manifest" ]] || fail "Android manifest is missing"
[[ -f "$gradle_file" ]] || fail "Android Gradle file is missing"
rg -q 'extends FoundryPlugin' "$bridge_source" || fail "bridge must extend FoundryPlugin"
rg -q 'return "SentryObservabilityBridge"' "$bridge_source" \
	|| fail "bridge must use the shared plugin name"
rg -q 'public String getPluginName\(\)' "$bridge_source" \
	|| fail "Android bridge must expose the exact Foundry plugin-name method"
for method in lifecycleVersion configure isAvailable capture captureLog captureBreadcrumb captureMetric flush shutdown; do
	rg -q "[[:space:]]$method\\(" "$bridge_source" \
		|| fail "bridge is missing $method"
done
rg -q 'public boolean isAvailable\(String owner\)' "$bridge_source" \
	|| fail "Android availability must require a lifecycle owner"
rg -q 'public int flush\(String owner, int timeoutMsec\)' "$bridge_source" \
	|| fail "Android flush must require a lifecycle owner"
rg -q 'public void shutdown\(String owner\)' "$bridge_source" \
	|| fail "Android shutdown must require a lifecycle owner"
rg -q 'public boolean replaceAttachments\(Object\[\] payloads\)' "$bridge_source" \
	|| fail "Android attachment replacement must consume the Foundry Array representation"
rg -q 'public String captureWithAttachments\(Dictionary payload\)' "$bridge_source" \
	|| fail "Android attachment-aware capture method is missing"
rg -q -U '@UsedByFoundry[[:space:]]+public String captureWithAttachments\(Dictionary payload\)' "$bridge_source" \
	|| fail "attachment-aware Android capture must remain a Foundry export"
rg -q -U '@UsedByFoundry[[:space:]]+public boolean replaceAttachments\(Object\[\] payloads\)' "$bridge_source" \
	|| fail "Android attachment replacement must remain a Foundry export"
rg -q 'static final SentryLifecycleCoordinator LIFECYCLE_COORDINATOR' "$bridge_source" \
	|| fail "Android bridge instances must share a process-global lifecycle coordinator"
rg -q 'lifecycle_owner' "$bridge_source" \
	|| fail "Android bridge configuration must consume the lifecycle owner"
rg -q 'io\.sentry:sentry-android:8\.50\.1' "$repo_root/addons/FoundryObservabilitySentry/android-dependencies.txt" \
	|| fail "Sentry Android dependency is not pinned to 8.50.1"
if [[ -z "${ANDROID_HOME:-}" ]]; then
	if [[ -n "${ANDROID_SDK_ROOT:-}" ]]; then
		export ANDROID_HOME="$ANDROID_SDK_ROOT"
	elif [[ -d "$HOME/Library/Android/sdk" ]]; then
		export ANDROID_HOME="$HOME/Library/Android/sdk"
	elif [[ -d "$HOME/Android/Sdk" ]]; then
		export ANDROID_HOME="$HOME/Android/Sdk"
	fi
fi
dependency_report=$(
	"$android_source/gradlew" -q -p "$android_source" \
		dependencies --configuration releaseRuntimeClasspath
)
rg -q 'io\.sentry:sentry-android-ndk:8\.50\.1' <<<"$dependency_report" \
	|| fail "Sentry Android release runtime must include NDK crash handling"
"$android_source/gradlew" -q -p "$android_source" compileReleaseJavaWithJavac
bridge_class=$(
	find "$android_source/build/intermediates/javac/release" \
		-type f \
		-path '*/classes/games/cafecito/android/foundryobservabilitysentry/SentryObservabilityBridge.class' \
		-print -quit
)
[[ -n "$bridge_class" ]] || fail "compiled Android bridge class is missing"
bridge_api=$(javap "$bridge_class")
rg -Fxq \
	'  public java.lang.String capture(games.cafecito.foundry.Dictionary);' \
	<<<"$bridge_api" \
	|| fail "compiled Android bridge has an incompatible capture signature"
rg -Fxq \
	'  public java.lang.String captureWithAttachments(games.cafecito.foundry.Dictionary);' \
	<<<"$bridge_api" \
	|| fail "compiled Android bridge has an incompatible attachment capture signature"
rg -Fxq \
	'  public boolean replaceAttachments(java.lang.Object[]);' \
	<<<"$bridge_api" \
	|| fail "compiled Android bridge has an incompatible attachment replacement signature"
rg -q '^[[:space:]]*options\.setAnrEnabled\(' "$bridge_source" \
	|| fail "Android bridge must configure native ANR detection"
rg -q '^[[:space:]]*options\.setAnrTimeoutIntervalMillis\(' "$bridge_source" \
	|| fail "Android bridge must configure the native ANR timeout"
rg -q '^[[:space:]]*options\.setAttachAnrThreadDump\(' "$bridge_source" \
	|| fail "Android bridge must configure ANR thread-dump attachment"
rg -q 'SentryAndroid\.init\(' "$driver_source" \
	|| fail "Android lifecycle driver must initialize Sentry Android"
rg -q 'options -> applyOptions\(options, configuration\)' "$driver_source" \
	|| fail "Android lifecycle driver must apply typed options during initialization"
rg -q 'options\.setEnableUncaughtExceptionHandler\(true\)' "$driver_source" \
	|| fail "Android lifecycle must explicitly enable uncaught exception handling"
rg -q 'options\.setEnableNdk\(true\)' "$driver_source" \
	|| fail "Android lifecycle must explicitly enable NDK crash handling"
rg -q 'options\.setEnableScopeSync\(true\)' "$driver_source" \
	|| fail "Android lifecycle must synchronize scope data to native crashes"
rg -q 'options\.setMaxAttachmentSize\(configuration\.maxAttachmentBytes\)' "$driver_source" \
	|| fail "Android lifecycle must configure the attachment size maximum"
rg -q 'final long maxAttachmentBytes;' "$configuration_source" \
	|| fail "Android lifecycle configuration must retain its typed attachment limit"
rg -q 'options\.setShutdownTimeoutMillis\(SHUTDOWN_TIMEOUT_MSEC\)' "$driver_source" \
	|| fail "Android lifecycle must use a bounded native shutdown"
rg -q 'Sentry\.configureScope' "$driver_source" \
	|| fail "Android lifecycle must install crash-persistent scope data"
rg -q '"foundry"' "$driver_source" \
	|| fail "Android lifecycle must use the stable foundry crash context"
rg -q 'Sentry\.captureEvent' "$bridge_source" || fail "bridge must capture Sentry events"
rg -q 'new Attachment\(' "$attachment_mapper" \
	|| fail "Android attachment mapper must construct native Sentry attachments"
rg -q 'AndroidSentrySdkDriver\.applyCaptureScope\(' "$bridge_source" \
	|| fail "Android attachment-aware capture must delegate to capture-local scope mapping"
rg -q 'scope\.addAttachment\(attachment\)' "$driver_source" \
	|| fail "Android native mapping must add attachments to the active scope"
rg -q 'Sentry\.logger\(\)' "$bridge_source" || fail "bridge must capture structured Sentry logs"
rg -q 'Sentry\.addBreadcrumb' "$bridge_source" || fail "bridge must capture Sentry breadcrumbs"
rg -q 'new Breadcrumb' "$breadcrumb_mapper" || fail "mapper must construct Sentry breadcrumbs"
rg -q 'SentryLogParameters' "$bridge_source" || fail "bridge must use Sentry log parameters"
rg -q 'SentryAttributes\.fromMap' "$bridge_source" || fail "bridge must preserve structured attributes"
rg -q 'getLogs\(\)\.setEnabled' "$driver_source" || fail "lifecycle must configure Sentry logs"
rg -q 'getMetrics\(\)\.setEnabled' "$driver_source" || fail "lifecycle must configure Sentry metrics"
rg -q 'Sentry\.metrics\(\)' "$bridge_source" || fail "bridge must capture Sentry metrics"
for metric in count gauge distribution; do
	rg -q "\\.${metric}\\(" "$bridge_source" \
		|| fail "bridge is missing the ${metric} mapping"
done
rg -q 'Sentry\.flush' "$driver_source" || fail "lifecycle must flush Sentry events"
rg -q 'Sentry\.close' "$driver_source" || fail "lifecycle must close Sentry"
if rg -n 'crashWith|crash_with|triggerNativeCrash|trigger_native_crash|badCode|bad_code' \
	"$bridge_source" "$lifecycle_source" "$driver_source"; then
	fail "production Android bridge contains a deliberate crash trigger"
fi

export_plugin="$repo_root/addons/FoundryObservabilitySentry/export_plugin.fs"
rg -q '_get_android_libraries' "$export_plugin" \
	|| fail "export plugin must add Android AARs"
rg -q '_get_android_dependencies' "$export_plugin" \
	|| fail "export plugin must add Android dependencies"
rg -q 'get_os_name\(\) == "Android"' "$export_plugin" \
	|| fail "Android export plugin must be Android-only"
rg -q 'FoundryObservabilitySentry-debug\.aar' "$export_plugin" \
	|| fail "debug AAR path is missing"
rg -q 'FoundryObservabilitySentry-release\.aar' "$export_plugin" \
	|| fail "release AAR path is missing"
rg -q 'android-dependencies\.txt' "$export_plugin" \
	|| fail "Android dependency file is missing"

echo "Sentry Android resolver contract checks passed"
